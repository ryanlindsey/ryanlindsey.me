{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ryanlindsey-me",
  "account_id": "1b764d090899bf1ee61a8d1e87c10710",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Day 3 Task 5 closes the day-1 open loop. /resume.pdf is the first route with
  // `export const prerender = false`, so Astro's build output flips from "static"
  // to "server", the adapter stops passing `main: undefined` to its Vite plugin,
  // and a real Worker bundle is emitted. `main` and the `ASSETS` binding are both
  // meaningful again -- and `main` is what carries `scheduled()`: without a server
  // bundle the cron handler runs under `astro dev` and is silently absent from the
  // deployed Worker.
  "main": "./src/worker.ts",
  // Day 3 Task 8 (02 §3): `run_worker_first` defaults to false, meaning a
  // request that matches a static asset is served straight from the Asset
  // Worker and NEVER reaches src/worker.ts's `fetch` at all -- confirmed
  // empirically (a debug header set unconditionally at the top of `fetch`
  // never appeared on a response for any of these paths without this
  // setting). Every one of Task 7's HTML content pages is exactly such a
  // static asset, so `Accept`-based negotiation would otherwise be dead code
  // for the one thing it exists to intercept.
  //
  // Scoped to the content routes only (not `true`/global), so every other
  // static asset -- `/_astro/*`, favicon, `robots.txt` (Task 12) -- keeps
  // the fast, Worker-free asset-serving path. `*` matches across path
  // segments (Cloudflare's own docs example has `/api/*` needing
  // `!/api/docs/*` to exclude a nested path), so `/writing/*` alone would
  // cover both `/writing/foo` and `/writing/foo/` -- but ALSO
  // `/writing/foo.md` itself: an already-suffixed request `markdownAssetPathFor`
  // rejects on sight (fix round 1), so routing it through the Worker bought
  // nothing but an extra hop before falling to the same asset it would have
  // been served directly anyway. The two `!.../*.md` negative patterns below
  // carve that back out -- negative patterns win regardless of list order
  // (Cloudflare's docs) -- which is also why `/resume.json`/`.md`/`.pdf`
  // never needed one: there is no `/resume/*` positive pattern to catch
  // them in the first place. The bare, no-slug forms (`/writing`, `/work`)
  // are listed explicitly rather than relied on, since neither takes a
  // markdown variant anyway and there is no reason to guess.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/resume",
      "/resume/",
      "/writing",
      "/writing/*",
      "!/writing/*.md",
      "/work",
      "/work/*",
      "!/work/*.md",
    ],
  },

  "workers_dev": false,
  "preview_urls": true,
  "routes": [{ "pattern": "ryanlindsey.me", "custom_domain": true }],
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ryanlindsey-me-db",
      "database_id": "3e7e8dfd-7926-4309-80ec-b583529394d3",
    },
  ],

  "kv_namespaces": [
    { "binding": "KV_CONFIG", "id": "aa1dd780da1e49eb8cf2dbf8ac9cf2b9" },
    { "binding": "KV_CACHE", "id": "c0a1106f9c9944979cd228070be21b53" },
  ],

  "r2_buckets": [
    { "binding": "R2_ASSETS", "bucket_name": "ryanlindsey-me-assets" },
    { "binding": "R2_PRIVATE", "bucket_name": "ryanlindsey-me-private" },
  ],

  "queues": {
    "producers": [{ "binding": "EVENTS", "queue": "ryanlindsey-me-events" }],
  },

  "analytics_engine_datasets": [{ "binding": "AE", "dataset": "ryanlindsey_me_events" }],

  // Browser Run, for /resume.pdf. Measured 2026-09-06 against the installed
  // miniflare (5.20260831.0-alpha): its bundle carries a real browser-rendering
  // plugin that downloads Chrome-for-Testing and launches it locally, and ZERO
  // references to `quickAction`. So `puppeteer.launch(env.BROWSER)` works here
  // with no Cloudflare credentials, and this binding is NOT remote-only -- the
  // day-1 comment that claimed it was has been deleted rather than moved.
  // Object, not array: the schema is `{ binding, remote? }` with
  // additionalProperties: false, and it is not inherited by named environments.
  "browser": { "binding": "BROWSER" },

  // 05:17 UTC daily. The handler is a no-op unless the résumé source hash has
  // moved (see src/lib/resume-pdf.ts), so the steady-state cost is one KV read.
  "triggers": { "crons": ["17 5 * * *"] },

  // Workers AI, for the publishing corpus's embedding job. It is back in day 3,
  // not day 4: the day-3 build track owns the corpus, and this is the binding it
  // runs on.
  //
  // The comment that stood here had been describing a false state for a day. It
  // said the gateway was "blocked on credits" -- resolved on day 2, when the
  // owner added AI Gateway credits, Unified Billing began serving env.AI.run()
  // and all four capability probes passed -- and that the binding would return
  // "on day 4", which was never this plan's shape.
  //
  // MEASURED against this account 2026-09-06 from a throwaway dev Worker, kept
  // here because no Cloudflare model page states qwen3's output width and a
  // Vectorize index can never change the one it is created at:
  //   env.AI.run('@cf/qwen/qwen3-embedding-0.6b', { documents: ['hello'] })
  //   -> { shape: [1, 1024] }, L2-normalised (|v| = 1.0000000).
  // Two input-shape findings from the same probe, so nothing rediscovers them:
  // `{ text: 'x' }` returns a BIT-IDENTICAL vector to `{ documents: ['x'] }`,
  // and `query` is either rejected on its own (3030: invalid input) or silently
  // ignored beside `documents` -- same vector, same 2 prompt tokens. This model
  // has NO query-side mode on Workers AI, so queries embed exactly like
  // documents. Both keys also take an array and batch: shape [n, 1024].
  //
  // No `remote`: Workers AI has no local emulator, so calls reach the real
  // account either way, and marking it remote would only add a route by which a
  // future test bills neurons. Object, not array, and -- like `browser` above --
  // NOT inherited by named environments.
  "ai": { "binding": "AI" },

  // The publishing corpus. Created 2026-09-07 at the 1024 measured above, metric
  // cosine, and BOTH of those are permanent: Vectorize has no resize and no way
  // to change a metric, so a wrong number here would have meant a new index and
  // a new name rather than an edit. That is why the binding was added in a
  // second commit, after `vectorize get` confirmed the index -- naming an index
  // that does not exist breaks `wrangler types` and every deploy.
  //
  // The `tier` and `type` metadata indexes were created immediately after the
  // index itself and BEFORE anything was upserted (confirmed: vectorCount 0 at
  // the time). This ordering is not a preference. Vectorize does not backfill
  // metadata indexes, and a filtered query against an unindexed property
  // returns partial or empty results with NO error -- so getting it wrong
  // produces a corpus that looks healthy and quietly under-answers. Any future
  // filterable property has to be indexed before the vectors carrying it land.
  //
  // Vectors go in pre-normalised (|v| = 1.0 straight from the model), so cosine
  // and dot product coincide and nothing has to normalise before upserting.
  //
  // No `remote`, and that cuts the OPPOSITE way from the `ai` binding above --
  // the two defaults are not the same and the difference is easy to lose.
  // Wrangler defaults an unset `remote` to remote for `ai` (no local emulator
  // exists) but to LOCAL SIMULATION for `vectorize`. So under `wrangler dev`
  // and under the test harness, `env.VECTORIZE` is a local simulated index, NOT
  // ryanlindsey-me-corpus. An embedding job run that way reports success and
  // leaves the real index at vectorCount 0.
  //
  // It is left local on purpose: flipping it to `remote: true` opens a remote
  // proxy session in the harness and breaks the same 8 suites the `ai` binding
  // did, for the same account-ambiguity reason. Anything that must write to the
  // real index should say so deliberately -- `wrangler vectorize insert`, the
  // deployed Worker, or a temporary `remote: true` -- rather than assuming this
  // binding points at production.
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "ryanlindsey-me-corpus" }],

  // No `destination_address`: this binding may send to any address verified on
  // Email Routing, and the owner's private address must not appear in a public repo.
  "send_email": [{ "name": "EMAIL" }],

  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
  ],

  "services": [{ "binding": "MCP", "service": "ryanlindsey-me-mcp" }],

  "secrets_store_secrets": [
    {
      "binding": "RLME_TOKEN_SIGNING_KEY",
      "store_id": "3b06d2a92de642d999509352cfd3ebed",
      "secret_name": "RLME_TOKEN_SIGNING_KEY",
    },
    {
      "binding": "RLME_TURNSTILE_SECRET_KEY",
      "store_id": "3b06d2a92de642d999509352cfd3ebed",
      "secret_name": "RLME_TURNSTILE_SECRET_KEY",
    },
  ],

  // SITE_ORIGIN is what the Browser Run job navigates to. It is deliberately a
  // var rather than something derived from `request.url`: Wrangler's
  // `--infer-origin-from-routes` defaults to true, so with the custom-domain
  // route above, `request.url` reads as https://ryanlindsey.me/... even under
  // local dev -- deriving the render URL from it would make local dev silently
  // render production. The test harness overrides it (tests/workers.ts); under
  // `astro dev`, override it in .dev.vars rather than editing this value.
  "vars": {
    "RLME_AI_GATEWAY_ID": "ryanlindsey-me",
    "SITE_ORIGIN": "https://ryanlindsey.me",
  },
}
