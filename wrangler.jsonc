{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ryanlindsey-me",
  "account_id": "1b764d090899bf1ee61a8d1e87c10710",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "main": "./src/worker.ts",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // Paths the Worker sees before the asset router. `/mcp/server-card` is the
    // first sub-path under /mcp anywhere: `/mcp` is an exact entry, so without
    // its own line the card falls through to the prerendered 404 and the
    // on-demand route never runs. tests/pages.test.ts's assertion that this
    // path answers 200 with the card, not the prerendered 404, is what
    // catches that.
    "run_worker_first": [
      "/resume",
      "/resume/",
      "/writing",
      "/writing/*",
      "/work",
      "/work/*",
      "/mcp",
      "/mcp/server-card",
      "/fit",
      "/fit/*",
      "/",
      "/llms.txt",
      "/llms-full.txt",
      "/resume.json",
      "/rss.xml",
      "/feed.json",
      "/robots.txt",
      "/chat",
      "/chat/*",
    ],
  },

  "workers_dev": false,
  "preview_urls": true,
  "routes": [{ "pattern": "ryanlindsey.me", "custom_domain": true }],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ryanlindsey-me-db",
      "database_id": "3e7e8dfd-7926-4309-80ec-b583529394d3",
    },
  ],

  "kv_namespaces": [
    { "binding": "KV_CONFIG", "id": "aa1dd780da1e49eb8cf2dbf8ac9cf2b9" },
    { "binding": "KV_CACHE", "id": "c0a1106f9c9944979cd228070be21b53" },
  ],

  "r2_buckets": [
    { "binding": "R2_ASSETS", "bucket_name": "ryanlindsey-me-assets" },
    // DECLARED AND UNUSED ON THIS WORKER (#180).
    { "binding": "R2_PRIVATE", "bucket_name": "ryanlindsey-me-private" },
  ],

  "queues": {
    "producers": [{ "binding": "EVENTS", "queue": "ryanlindsey-me-events" }],
    "consumers": [
      {
        "queue": "ryanlindsey-me-events",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "ryanlindsey-me-events-dlq",
      },
    ],
  },

  "analytics_engine_datasets": [{ "binding": "AE", "dataset": "ryanlindsey_me_events" }],

  // DECLARED AND UNUSED ON THIS WORKER (#180, #186).
  "browser": { "binding": "BROWSER" },

  "triggers": { "crons": ["47 5 * * *", "*/5 * * * *"] },

  "send_email": [{ "name": "EMAIL" }],

  "services": [{ "binding": "MCP", "service": "ryanlindsey-me-mcp" }],

  "secrets_store_secrets": [
    // DECLARED AND UNUSED ON THIS WORKER (#180).
    {
      "binding": "RLME_TOKEN_SIGNING_KEY",
      "store_id": "3b06d2a92de642d999509352cfd3ebed",
      "secret_name": "RLME_TOKEN_SIGNING_KEY",
    },
    {
      "binding": "RLME_TURNSTILE_SECRET_KEY",
      "store_id": "3b06d2a92de642d999509352cfd3ebed",
      "secret_name": "RLME_TURNSTILE_SECRET_KEY",
    },
    {
      "binding": "RLME_NOTIFY_ADDRESS",
      "store_id": "3b06d2a92de642d999509352cfd3ebed",
      "secret_name": "RLME_NOTIFY_ADDRESS",
    },
    {
      "binding": "RLME_ANALYTICS_TOKEN",
      "store_id": "3b06d2a92de642d999509352cfd3ebed",
      "secret_name": "RLME_ANALYTICS_TOKEN",
    },
  ],

  "vars": {
    "RLME_AI_GATEWAY_ID": "ryanlindsey-me",
    "RLME_ACCOUNT_ID": "1b764d090899bf1ee61a8d1e87c10710",
    "RLME_NOTIFY_FROM": "notifications@ryanlindsey.me",
    "SITE_ORIGIN": "https://ryanlindsey.me",
    "RLME_TURNSTILE_SITEKEY": "0x4AAAAAAElhnY8ov3OYHN8m",
  },
}
