{
  "name": "ryanlindsey-me",
  "version": "1.41.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "typegen": "wrangler types",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "astro build && vitest run",
