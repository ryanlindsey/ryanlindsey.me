    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.0",
    "wrangler": "4.129.0",
    "yaml": "2.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260831.1": true,
    "core-js-pure": false,
    "fsevents": false
