    "deploy": "astro build && wrangler deploy",
    "deploy:mcp": "wrangler deploy --config workers/mcp/wrangler.jsonc",
    "token": "node scripts/token.mjs",
    "private-doc": "node scripts/private-doc.mjs",
    "registry:publish": "node scripts/registry-publish.mjs",
    "resume:pdf": "astro build && node scripts/resume-sheet.mjs",
    "resume:gate": "node scripts/resume-gate.mjs",
    "icons": "node scripts/icons.mjs",
    "evals": "node evals/run.mjs",
    "resume:chrome": "node scripts/resume-chrome.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.2",
    "@astrojs/markdown-satteri": "0.4.1",
    "@astrojs/mdx": "8.0.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.24.0",
    "astro": "7.3.3",
    "astro-expressive-code": "0.44.2",
    "github-slugger": "2.0.0",
    "reading-time": "1.5.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@puppeteer/browsers": "^3.2.2",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.2",
    "jsdom": "30.1.0",
    "opentype.js": "2.0.0",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "1.0.1",
    "satori": "0.33.5",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "unpdf": "1.8.1",
    "vitest": "5.0.1",
    "wrangler": "4.135.0",
    "yaml": "2.9.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
