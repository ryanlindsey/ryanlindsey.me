{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ryanlindsey-me-mcp",
  "account_id": "1b764d090899bf1ee61a8d1e87c10710",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],

  // Measured 2026-09-20: the bundle wrangler builds from this config carried
  // 1771 comment lines, including src/lib/tier/token.ts on what each scope
  // opens. This Worker is the one that resolves grants, so it holds the most
  // of that reasoning and had been shipping all of it.
  //
  // astro.config.mjs fixed the same leak on the site Worker and cannot fix it
  // here: wrangler builds this one from src/index.ts without reading that file.
  // `minify` is wrangler's own switch for it, and esbuild drops comments as
  // part of minifying rather than as a separate option.
  //
  // `upload_source_maps` is what makes that affordable. `observability` below
  // is on and these logs get read, so minifying without it would trade the
  // comments for unreadable stack traces. With it, Cloudflare maps a minified
  // frame back to the original file and line.
  "minify": true,
  "upload_source_maps": true,

  "workers_dev": false,
  "routes": [{ "pattern": "mcp.ryanlindsey.me", "custom_domain": true }],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ryanlindsey-me-db",
      "database_id": "3e7e8dfd-7926-4309-80ec-b583529394d3",
      "migrations_dir": "../../migrations",
    },
  ],

  "kv_namespaces": [
    { "binding": "KV_CONFIG", "id": "aa1dd780da1e49eb8cf2dbf8ac9cf2b9" },
    { "binding": "KV_CACHE", "id": "c0a1106f9c9944979cd228070be21b53" },
  ],

  "r2_buckets": [
    { "binding": "R2_ASSETS", "bucket_name": "ryanlindsey-me-assets" },
    { "binding": "R2_PRIVATE", "bucket_name": "ryanlindsey-me-private" },
  ],

  "analytics_engine_datasets": [{ "binding": "AE", "dataset": "ryanlindsey_me_events" }],

  "queues": { "producers": [{ "binding": "EVENTS", "queue": "ryanlindsey-me-events" }] },

  "ai": { "binding": "AI" },

  "vectorize": [{ "binding": "VECTORIZE", "index_name": "ryanlindsey-me-corpus" }],

  "ai_search": [{ "binding": "AI_SEARCH", "instance_name": "ryanlindsey-me-search" }],

  // 05:32 refreshes the Vectorize corpus. 05:52 daily and 07:07 on Mondays run
  // the eval suites (issue #291): `tier` daily, because it is the cheapest and
  // needs no grant, and `fit`/`chat`/`leak` weekly, because they spend
  // inference through a shared quota. The three expressions are also spelled
  // in src/lib/evals/plan.ts as CORPUS_CRON, EVALS_DAILY_CRON and
  // EVALS_WEEKLY_CRON, which is what `suitesForCron` maps; tests/evals-schedule.test.ts
  // fails if this list and those constants drift either way.
  //
  // THE MONDAY GAP IS 95 MINUTES AND IT IS SLACK, NOT A MEASUREMENT: `fit` and
  // `chat` are graded against the index the 05:32 job upserts, Vectorize
  // applies an upsert asynchronously, and nothing here has timed either. The
  // constant's comment in src/lib/evals/plan.ts says what would settle it.
  "triggers": { "crons": ["32 5 * * *", "52 5 * * *", "7 7 * * 1"] },

  // The scheduled eval run. A Workflow rather than work done in `scheduled()`
  // because a weekly run is fifteen inference calls paced twenty-five seconds
  // apart: `step.sleep` suspends the instance instead of holding an invocation
  // open, and `step.do` persists each case so a restart replays rather than
  // re-pays. workers/mcp/src/evals-workflow.ts records the 2026-09-18
  // measurement that this binding, unlike `ai` and `ai_search`, boots and
  // creates instances under the test harness.
  //
  // The deferred fit run (issue #349) is the second. A Workflow rather than
  // `ctx.waitUntil` because that budget is 30 seconds for an HTTP-triggered
  // Worker and the run it was holding was measured at 78,222 ms -- confirmed
  // against production on 2026-09-22, where the row stayed `pending` out to
  // t+150 s and the UPDATE never ran. Its instance id is the permalink id, so
  // `wrangler workflows instances describe rlme-fit <id>` answers what became
  // of a report somebody is holding a link to.
  "workflows": [
    { "name": "rlme-evals", "binding": "EVALS_WORKFLOW", "class_name": "EvalsWorkflow" },
    { "name": "rlme-fit", "binding": "FIT_WORKFLOW", "class_name": "FitWorkflow" },
  ],

  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }],

  "secrets_store_secrets": [
    {
      "binding": "RLME_TOKEN_SIGNING_KEY",
      "store_id": "3b06d2a92de642d999509352cfd3ebed",
      "secret_name": "RLME_TOKEN_SIGNING_KEY",
    },
    {
      "binding": "RLME_TURNSTILE_SECRET_KEY",
      "store_id": "3b06d2a92de642d999509352cfd3ebed",
      "secret_name": "RLME_TURNSTILE_SECRET_KEY",
    },
  ],

  "rules": [{ "type": "Text", "globs": ["**/prompts/*.md?raw"], "fallthrough": true }],

  "services": [
    { "binding": "SITE", "service": "ryanlindsey-me" },
    // THIS WORKER, BOUND TO ITSELF (issue #291), so the scheduled eval run
    // reaches `/mcp` and `/chat` the way a client does.
    //
    // WHY A SERVICE BINDING AND NOT A GLOBAL FETCH to mcp.ryanlindsey.me. A
    // service-binding dispatch re-enters this Worker's own `fetch` handler, so
    // the scheduled run crosses the same boundary and the same `resolveGrant`
    // a real client crosses. MEASURED 2026-09-18: with this binding declared,
    // `env.SELF.fetch('https://mcp.ryanlindsey.me/mcp', ...)` carrying a
    // deliberately bad bearer answered 200 with a real SSE `event: message`
    // frame holding the public tool list -- the token refused, the caller
    // served the public tier, which is exactly what `resolveGrant` is designed
    // to do.
    //
    // The alternative, a global `fetch` to this Worker's own custom domain,
    // was not chosen because nothing here has measured it, and the last
    // unmeasured same-hostname fetch in this repository cost issue #28's 522 --
    // workers/mcp/src/index.ts carries that story at length. A service binding
    // never reaches Cloudflare's edge, so it has no hostname to collide with.
    //
    // This is not a lesser transport either: src/pages/chat/send.ts already
    // reaches `POST /chat` over `env.MCP.fetch`, so a service-binding dispatch
    // is how every real browser chat turn arrives.
    { "binding": "SELF", "service": "ryanlindsey-me-mcp" },
  ],

  "vars": {
    "RLME_AI_GATEWAY_ID": "ryanlindsey-me",
    "SITE_ORIGIN": "https://ryanlindsey.me",
  },
}
