---
import '../styles/global.css';
import { getResume } from '../lib/resume-collection';
import { buildPerson, stringifyJsonLd } from '../lib/structured-data';

interface Props {
  title: string;
  description?: string;
  // Root-relative URL of this page's markdown variant (e.g. `/writing/foo.md`),
  // e.g. from Task 6's toMarkdown() by way of a `.md.ts` sibling route (Task 7).
  // An explicit prop rather than inferring one from Astro.url.pathname: that
  // would couple this base layout to route structure, and a route added later
  // with no `.md` variant would silently emit a link to a file that 404s.
  markdownHref?: string;
  // Task 10 (02 §3): this page's own JSON-LD node(s) -- BlogPosting plus
  // BreadcrumbList for a post, TechArticle for a case study -- threaded
  // through Shell/ArticleLayout the same way `markdownHref` is. A separate
  // prop rather than folding both into one page-descriptor object -- two
  // small orthogonal optional props beat a polymorphic one invented before
  // either consumer exists. `Person` is deliberately NOT part of this prop:
  // see below.
  structuredData?: object;
  /**
   * This page's robots directive. The default is the SITEWIDE `noindex` that
   * day 7 removes -- but an unlisted page (09 §1: absent from nav, sitemap and
   * llms.txt) needs its own, which is why this is a prop rather than a
   * constant. `/fit` passes `noindex, nofollow`, and that value survives day 7
   * changing the default, which is the whole point of the prop existing now.
   */
  robots?: string;
}

const {
  title,
  description = 'Engineering leadership and agentic systems.',
  markdownHref,
  structuredData,
  robots = 'noindex',
} = Astro.props;

// Person, sitewide (task-10-brief.md), built here rather than passed in by
// every page: it is the same node everywhere, sourced from the one
// validated résumé record every other format already reads (resume.astro,
// /resume.md, /resume.json, /resume.pdf, /llms.txt) -- one more call site
// to that reader, not a new data path. `sameAs` (research appendix B3.1's
// entity-disambiguation payload) comes from `basics.profiles`, which is
// empty in today's real résumé data (resumeGaps() already reports that gap
// on /resume); buildPerson() omits the field entirely until the content
// track fills it in, with no change needed here.
const resume = await getResume();
const person = buildPerson({
  name: resume.basics.name,
  url: new URL('/', Astro.site).href,
  jobTitle: resume.basics.label,
  sameAs: resume.basics.profiles.map((profile) => profile.url),
});

// A bare object from a page (TechArticle) becomes a one-element array; an
// already-array page value (a post's [BlogPosting, BreadcrumbList]) passes
// through unchanged. Person always leads, so it is present even on pages
// (the home page, /resume, the index pages) that pass no `structuredData`
// of their own.
const jsonLdNodes = [
  person,
  ...(structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- Removed at launch (day 7). Nothing here should be indexed before then. -->
    <!-- Day 7 changes the DEFAULT above. It must not delete the tag, because
         `/fit` and `/fit/r/<id>` pass their own value. -->
    <meta name="robots" content={robots} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {
      /* Sitewide feed autodiscovery (day 3 Task 11, 02 §3) -- unlike the
       markdownHref block below, these are not conditional on any per-page
       prop: every page on the site is covered by the same one RSS feed and
       one JSON Feed, the same way every page shares one /llms.txt. */
    }
    <link rel="alternate" type="application/rss+xml" title="Ryan Lindsey" href="/rss.xml" />
    {
      /* JSON Feed's own spec (jsonfeed.org/version/1.1, Discovery section)
       gives this exact markup, including `type="application/feed+json"` --
       the same media type the feed is actually served with (see
       src/pages/feed.json.ts and public/_headers), not the more generic
       `application/json` some older feeds still use. */
    }
    <link rel="alternate" type="application/feed+json" title="Ryan Lindsey" href="/feed.json" />
    {
      /* rel="describedby" points at the llms.txt file that COVERS this page
       (llms.txt v2, research appendix B1.2/B2.2), not at the page's own .md
       twin -- that was Task 7's mistake, fixed in Task 9 (the earliest point
       /llms.txt existed to point at). No `type` attribute, matching the
       spec's own header-form example verbatim
       (`</docs/llms.txt>; rel="describedby"`, no `type`) -- llms.txt is not
       itself markdown.

       SITEWIDE, exactly like the two feed links above, and for the same
       reason (fix round 2): this site has one, root-level, unscoped
       /llms.txt (v2's "most specific file applies" rule, B1.3), so EVERY
       page is covered by it -- including the ones with no markdown twin.
       This tag used to sit inside the `markdownHref &&` block below, which
       made "is this page described by /llms.txt?" accidentally conditional
       on "does this page have a .md variant?", and silently dropped the tag
       from the home page and both index pages. Two unrelated facts, two
       independent tags.

       Fix round 1 (task-9-report.md): this is genuinely spec-only today --
       the research appendix found no site in its sample emitting
       rel="describedby" yet. Shipped because it is free and correct, not
       because anything is known to consume it. */
    }
    <link rel="describedby" href="/llms.txt" />
    {
      /* rel="alternate" has pre-existing adoption (OpenAI's Codex CLI
       follows it) and points at THIS page's own markdown twin -- so unlike
       the sitewide links above, it is conditional on the page actually
       having one. */
      markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} />
    }
    {
      // One <script> per node rather than one script wrapping an array or an
      // `@graph`: task-10-brief.md asks for four standalone types (Person,
      // BlogPosting, BreadcrumbList, TechArticle), not the cross-node `@id`
      // linking research appendix B3.1 sketches for a larger site -- that
      // shape was not asked for here and nothing consumes it yet.
      // `set:html` (not text interpolation) is required: Astro's default
      // text interpolation HTML-escapes its input, which would corrupt the
      // embedded JSON; `stringifyJsonLd` already neutralises the one
      // injection risk (a field value containing a literal `</script>`).
      jsonLdNodes.map((node) => (
        <script type="application/ld+json" is:inline set:html={stringifyJsonLd(node)} />
      ))
    }
    <title>{title}</title>

    <!--
      Blocking and inline on purpose. Anything deferred paints the wrong theme
      first. `is:inline` keeps Astro from bundling it into a module script,
      which would defer it. Kept small enough that the parser cost is noise.
    -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('rl-theme');
          const theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.setAttribute('data-theme', theme);
        } catch {
          // Private mode can throw on localStorage access. Fall back to the
          // media query alone rather than leaving the page unthemed.
          document.documentElement.setAttribute(
            'data-theme',
            matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light',
          );
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
