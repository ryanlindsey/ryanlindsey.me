---
import '../styles/global.css';
import { getResume } from '../lib/resume-collection';
import { buildPerson, stringifyJsonLd } from '../lib/structured-data';

interface Props {
  title: string;
  /**
   * True for the one page whose title already IS the site name (issue #153,
   * epic #150) -- today, only the home page. Without this opt-out, applying
   * the suffix below unconditionally turns "Ryan Lindsey" into "Ryan Lindsey
   * — Ryan Lindsey", which tests/pages.test.ts:507 and
   * tests/site.smoke.test.ts:39 both assert against by exact string and
   * neither may be edited to tolerate.
   *
   * A boolean rather than a format-string prop: there is one suffix, it has
   * never varied since this file started applying it, and a template would be
   * a configuration point with a single caller.
   */
  titleIsSiteName?: boolean;
  description?: string;
  // Root-relative URL of this page's markdown variant (e.g. `/writing/foo.md`),
  // e.g. from Task 6's toMarkdown() by way of a `.md.ts` sibling route (Task 7).
  // An explicit prop rather than inferring one from Astro.url.pathname: that
  // would couple this base layout to route structure, and a route added later
  // with no `.md` variant would silently emit a link to a file that 404s.
  markdownHref?: string;
  // Task 10 (02 §3): this page's own JSON-LD node(s) -- BlogPosting plus
  // BreadcrumbList for a post, TechArticle for a case study -- threaded
  // through Shell/ArticleLayout the same way `markdownHref` is. A separate
  // prop rather than folding both into one page-descriptor object -- two
  // small orthogonal optional props beat a polymorphic one invented before
  // either consumer exists. `Person` is deliberately NOT part of this prop:
  // see below.
  structuredData?: object;
  /**
   * This page's robots directive. The default WAS the sitewide `noindex` that
   * kept the site out of search before launch; launch flipped it to
   * `index, follow`, which is the state you are reading.
   *
   * The prop is why that flip was one line. An unlisted page (09 §1: absent
   * from nav, sitemap and llms.txt) needs its own directive regardless of what
   * the default happens to be, so `/fit` and `/fit/r/<id>` have always passed
   * `noindex, nofollow` explicitly rather than leaning on the default -- and
   * they kept it, untouched, when the default moved underneath them. That was
   * the whole point of this being a prop before there was any second value for
   * it to hold.
   *
   * DRAFTS ARE THE OTHER CALLER, and they are new as of that flip. Every draft
   * has a real route on purpose (src/pages/writing/[...slug].astro: "work in
   * progress is shareable by URL without entering the site's navigation"), so
   * an indexable default would have made every unpublished document
   * indexable. The two `[...slug].astro` routes now pass `noindex, nofollow`
   * for a draft, and src/lib/unindexed-routes.mjs keeps the same documents out
   * of the sitemap -- two independent mechanisms, because one of them being
   * the only thing between a draft and Google is too thin.
   */
  robots?: string;
  /**
   * This page's referrer policy, as a meta tag. Unset on every page but one,
   * so there is no default and no tag: a site-wide referrer policy is a
   * separate decision from this one and is not being made here.
   *
   * `/fit` sets `strict-origin`, and it is load-bearing rather than tidy. That
   * page's URL CARRIES A SCOPED TOKEN, and the Turnstile widget on it loads a
   * script from challenges.cloudflare.com -- a cross-origin subresource
   * request that would otherwise send this URL as the `Referer`. The header
   * form is set in src/worker.ts; this is the second, independent delivery of
   * the same policy, because that header's reachability depends on asset
   * routing config (`run_worker_first` in wrangler.jsonc) and the token's
   * confinement should not rest on one line.
   *
   * IT WAS `no-referrer` UNTIL 2026-09-17, and the meta tag was half of what
   * broke the form: a document's referrer policy is what Fetch reads when it
   * decides to serialize a form POST's `Origin` as the literal `null`, so this
   * tag caused the failure just as the header did, and changing one without
   * the other would have left it standing. `strict-origin` withholds the path
   * and the query from every `Referer`, which is the whole of what this prop
   * was ever for. src/worker.ts carries the measurement and the reasoning.
   */
  referrer?: string;
}

const {
  title,
  titleIsSiteName = false,
  // The sitewide fallback for a page that omits `description`. `/` was the
  // one page that did, until issue #152: `src/pages/index.astro` passed a
  // `title` and nothing else, so the site's most important page carried this
  // generic line by falling through rather than by decision. `/` writes its
  // own description now, so nothing in this repository reaches this default
  // as of that fix -- `description` stays optional because a future page
  // still could omit it, and if one does, it lands here.
  //
  // Left under the 70-character floor tests/seo.test.ts asserts for every
  // indexable page, rather than padded to clear it: a page reaching this
  // default is the exact failure #152 found, so the test failing on it is
  // the push back toward writing that page a real description, not a defect
  // in this string.
  description = 'Engineering leadership and agentic systems.',
  markdownHref,
  structuredData,
  robots = 'index, follow',
  referrer,
} = Astro.props;

/**
 * `— Ryan Lindsey`, applied in the one file that renders `<title>` (issue
 * #153, epic #150). It used to be built in six different places -- MEASURED
 * against a clean build, 2026-09-13: `src/layouts/ArticleLayout.astro`, the
 * `/writing` and `/work` index pages, `src/pages/ops.astro`,
 * `src/pages/writing/pillar/[pillar].astro` and `src/pages/resume.astro` all
 * hand-built it -- and forgotten on two: `/ai-policy/`, whose title rendered
 * bare, and `/chat/`, whose `Ask my agent` no earlier audit of this suffix had
 * named. Six call sites agreeing was never the property to rely on; this line
 * is.
 */
const pageTitle = titleIsSiteName ? title : `${title} — Ryan Lindsey`;

// Person, sitewide (task-10-brief.md), built here rather than passed in by
// every page: it is the same node everywhere, sourced from the one
// validated résumé record every other format already reads (resume.astro,
// /resume.md, /resume.json, /resume.pdf, /llms.txt) -- one more call site
// to that reader, not a new data path. `sameAs` (research appendix B3.1's
// entity-disambiguation payload) comes from `basics.profiles`, which is
// empty in today's real résumé data (resumeGaps() already reports that gap
// on /resume); buildPerson() omits the field entirely until the content
// track fills it in, with no change needed here.
const resume = await getResume();
const person = buildPerson({
  name: resume.basics.name,
  url: new URL('/', Astro.site).href,
  jobTitle: resume.basics.label,
  sameAs: resume.basics.profiles.map((profile) => profile.url),
});

// A bare object from a page (TechArticle) becomes a one-element array; an
// already-array page value (a post's [BlogPosting, BreadcrumbList]) passes
// through unchanged. Person always leads, so it is present even on pages
// (the home page, /resume, the index pages) that pass no `structuredData`
// of their own.
const jsonLdNodes = [
  person,
  ...(structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {/* An Astro comment, NOT an HTML one, and that is the fix rather than a
         style choice. The `<!-- -->` that stood here shipped into every page
         of the site, and it named the unlisted routes (09 §1) it was warning
         about -- publishing, on every page, the paths whose whole requirement
         is not being advertised. It also contained the word "noindex", which
         was enough to keep two `toContain('noindex')` tests green against a
         page that had just become indexable.
         The reasoning it carried lives on the `robots` prop above, where it
         belongs and where it does not ship. The short version: the tag below
         stays even though the default is now permissive, because the callers
         that pass their own value depend on it being rendered. */}
    <meta name="robots" content={robots} />
    {referrer && <meta name="referrer" content={referrer} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {/* Sitewide feed autodiscovery (day 3 Task 11, 02 §3) -- unlike the
       markdownHref block below, these are not conditional on any per-page
       prop: every page on the site is covered by the same one RSS feed and
       one JSON Feed, the same way every page shares one /llms.txt. */}
    <link rel="alternate" type="application/rss+xml" title="Ryan Lindsey" href="/rss.xml" />
    {/* JSON Feed's own spec (jsonfeed.org/version/1.1, Discovery section)
       gives this exact markup, including `type="application/feed+json"` --
       the same media type the feed is actually served with (see
       src/pages/feed.json.ts and public/_headers), not the more generic
       `application/json` some older feeds still use. */}
    <link rel="alternate" type="application/feed+json" title="Ryan Lindsey" href="/feed.json" />
    {/* rel="describedby" points at the llms.txt file that COVERS this page
       (llms.txt v2, research appendix B1.2/B2.2), not at the page's own .md
       twin -- that was Task 7's mistake, fixed in Task 9 (the earliest point
       /llms.txt existed to point at). No `type` attribute, matching the
       spec's own header-form example verbatim
       (`</docs/llms.txt>; rel="describedby"`, no `type`) -- llms.txt is not
       itself markdown.

       SITEWIDE, exactly like the two feed links above, and for the same
       reason (fix round 2): this site has one, root-level, unscoped
       /llms.txt (v2's "most specific file applies" rule, B1.3), so EVERY
       page is covered by it -- including the ones with no markdown twin.
       This tag used to sit inside the `markdownHref &&` block below, which
       made "is this page described by /llms.txt?" accidentally conditional
       on "does this page have a .md variant?", and silently dropped the tag
       from the home page and both index pages. Two unrelated facts, two
       independent tags.

       Fix round 1 (task-9-report.md): this is genuinely spec-only today --
       the research appendix found no site in its sample emitting
       rel="describedby" yet. Shipped because it is free and correct, not
       because anything is known to consume it. */}
    <link rel="describedby" href="/llms.txt" />
    {
      /* rel="alternate" has pre-existing adoption (OpenAI's Codex CLI
       follows it) and points at THIS page's own markdown twin -- so unlike
       the sitewide links above, it is conditional on the page actually
       having one. */
      markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} />
    }
    {
      // One <script> per node rather than one script wrapping an array or an
      // `@graph`: task-10-brief.md asks for four standalone types (Person,
      // BlogPosting, BreadcrumbList, TechArticle), not the cross-node `@id`
      // linking research appendix B3.1 sketches for a larger site -- that
      // shape was not asked for here and nothing consumes it yet.
      // `set:html` (not text interpolation) is required: Astro's default
      // text interpolation HTML-escapes its input, which would corrupt the
      // embedded JSON; `stringifyJsonLd` already neutralises the one
      // injection risk (a field value containing a literal `</script>`).
      jsonLdNodes.map((node) => (
        <script type="application/ld+json" is:inline set:html={stringifyJsonLd(node)}></script>
      ))
    }
    <title>{pageTitle}</title>

    <!--
      Blocking and inline on purpose. Anything deferred paints the wrong theme
      first. `is:inline` keeps Astro from bundling it into a module script,
      which would defer it. Kept small enough that the parser cost is noise.
    -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('rl-theme');
          const theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.setAttribute('data-theme', theme);
        } catch {
          // Private mode can throw on localStorage access. Fall back to the
          // media query alone rather than leaving the page unthemed.
          document.documentElement.setAttribute(
            'data-theme',
            matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light',
          );
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
