---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  // Root-relative URL of this page's markdown variant (e.g. `/writing/foo.md`),
  // e.g. from Task 6's toMarkdown() by way of a `.md.ts` sibling route (Task 7).
  // An explicit prop rather than inferring one from Astro.url.pathname: that
  // would couple this base layout to route structure, and a route added later
  // with no `.md` variant would silently emit a link to a file that 404s.
  // Task 10 gets its own `structuredData?: object` prop rather than folding
  // both into one page-descriptor object -- two small orthogonal optional
  // props beat a polymorphic one invented before either consumer exists.
  markdownHref?: string;
}

const {
  title,
  description = 'Engineering leadership and agentic systems.',
  markdownHref,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- Removed at launch (day 7). Nothing here should be indexed before then. -->
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {
      markdownHref && (
        <>
          {/* rel="alternate" has pre-existing adoption (OpenAI's Codex CLI
             follows it) and points at THIS page's own markdown twin. */}
          <link rel="alternate" type="text/markdown" href={markdownHref} />
          {/* rel="describedby" points at the llms.txt file that COVERS this
             page (llms.txt v2, research appendix B1.2/B2.2), not at the
             page's own .md twin -- that was Task 7's mistake, fixed here in
             Task 9 (the earliest point /llms.txt existed to point at). No
             `type` attribute, matching the spec's own header-form example
             verbatim (`</docs/llms.txt>; rel="describedby"`, no `type`) --
             llms.txt is not itself markdown. Hardcoded to the one, root-level
             /llms.txt: this site has no subpath-scoped llms.txt files (v2's
             "most specific file applies" rule, B1.3), so every page is
             covered by the same one. Fix round 1 (task-9-report.md): this is
             genuinely spec-only today -- the research appendix found no site
             in its sample emitting rel="describedby" yet. Shipped because it
             is free and correct, not because anything is known to consume it. */}
          <link rel="describedby" href="/llms.txt" />
        </>
      )
    }
    <title>{title}</title>

    <!--
      Blocking and inline on purpose. Anything deferred paints the wrong theme
      first. `is:inline` keeps Astro from bundling it into a module script,
      which would defer it. Kept small enough that the parser cost is noise.
    -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('rl-theme');
          const theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.setAttribute('data-theme', theme);
        } catch {
          // Private mode can throw on localStorage access. Fall back to the
          // media query alone rather than leaving the page unthemed.
          document.documentElement.setAttribute(
            'data-theme',
            matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light',
          );
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
