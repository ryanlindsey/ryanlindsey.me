---
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { OgCard } from '../lib/og/cards';

interface Props {
  title: string;
  // Pure pass-through to Base.astro's opt-out (issue #153) -- see that file
  // for what it is and why a boolean is enough.
  titleIsSiteName?: boolean;
  description?: string;
  markdownHref?: string;
  // Task 10 (02 §3): pure pass-through, same as `markdownHref` -- see
  // Base.astro for what this prop is and why Person is not part of it.
  structuredData?: object;
  // Pure pass-through as well. Undefined here means "take Base's default"
  // (`index, follow` since launch); a draft route passes `noindex, nofollow`.
  robots?: string;
  /**
   * Pure pass-through, and the one prop that had to be added here before
   * `/fit` and `/fit/r/<id>` could stop reaching past this layout to
   * `Base.astro` directly. They are still the only callers that set it.
   *
   * NOT OPTIONAL IN THE WAY THE `?` SUGGESTS. `/fit`'s URL carries a token and
   * its Turnstile widget loads a cross-origin script, so `strict-origin` is
   * what keeps that URL out of a third party's `Referer`; Base.astro's own
   * prop comment carries the measurement, including the day in September 2026
   * that `no-referrer` broke the form. Dropping this line would compile, would
   * pass every test that reads the RESPONSE HEADER (src/worker.ts sets that
   * one independently), and would silently delete the second delivery that
   * exists because the header's reachability depends on asset routing config.
   * tests/fit-pages.test.ts asserts the meta tag for exactly that reason.
   */
  referrer?: string;
  /**
   * Pure pass-through, added for the same caller that forced `referrer` down
   * this layout: `/fit/r/<id>` sets it while its run is still pending (#276),
   * and it is the only caller. See Base.astro for what the tag is, and for why
   * a meta refresh rather than a script is the point rather than a shortcut.
   *
   * IT HAD TO BE ADDED IN BOTH FILES, which is the thing worth knowing before
   * the next prop. Neither this layout nor `Base.astro` carried it, and a page
   * that passed `refresh` to `Shell` alone would compile, render, and silently
   * never emit the tag -- so the pending permalink would sit there forever
   * telling a reader it was about to refresh. tests/fit-pages.test.ts asserts
   * the tag against the rendered HTML for exactly that reason.
   */
  refresh?: number;
  /** Pure pass-through to Base.astro (#363); see that file. */
  ogCard?: OgCard;
  ogType?: 'website' | 'article';
  // 2026-09 redesign (issue #99): sticky is a route decision, not a viewport
  // one -- only ArticleLayout.astro (the template both article routes share)
  // passes true. Every other caller takes the default and its header scrolls
  // away like the rest of the page.
  stickyHeader?: boolean;
}

const {
  title,
  titleIsSiteName,
  description,
  markdownHref,
  structuredData,
  robots,
  referrer,
  refresh,
  ogCard,
  ogType,
  stickyHeader,
} = Astro.props;
---

<Base
  title={title}
  titleIsSiteName={titleIsSiteName}
  description={description}
  markdownHref={markdownHref}
  structuredData={structuredData}
  robots={robots}
  referrer={referrer}
  refresh={refresh}
  ogCard={ogCard}
  ogType={ogType}
>
  <a
    href="#main"
    class="sr-only font-mono text-small focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-accent-ground focus:px-3 focus:py-2 focus:text-accent-on"
  >
    Skip to content
  </a>

  <div class="flex min-h-dvh flex-col">
    <SiteHeader sticky={stickyHeader} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </div>
</Base>
