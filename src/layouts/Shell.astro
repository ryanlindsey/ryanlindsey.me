---
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  markdownHref?: string;
  // Task 10 (02 §3): pure pass-through, same as `markdownHref` -- see
  // Base.astro for what this prop is and why Person is not part of it.
  structuredData?: object;
  // Pure pass-through as well. Undefined here means "take Base's default"
  // (`index, follow` since launch); a draft route passes `noindex, nofollow`.
  robots?: string;
}

const { title, description, markdownHref, structuredData, robots } = Astro.props;
---

<Base
  title={title}
  description={description}
  markdownHref={markdownHref}
  structuredData={structuredData}
  robots={robots}
>
  <a
    href="#main"
    class="sr-only font-mono text-small focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-accent-ground focus:px-3 focus:py-2 focus:text-accent-on"
    >Skip to content</a
  >

  <div class="flex min-h-dvh flex-col">
    <SiteHeader />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </div>
</Base>
