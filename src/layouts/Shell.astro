---
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  // Pure pass-through to Base.astro's opt-out (issue #153) -- see that file
  // for what it is and why a boolean is enough.
  titleIsSiteName?: boolean;
  description?: string;
  markdownHref?: string;
  // Task 10 (02 §3): pure pass-through, same as `markdownHref` -- see
  // Base.astro for what this prop is and why Person is not part of it.
  structuredData?: object;
  // Pure pass-through as well. Undefined here means "take Base's default"
  // (`index, follow` since launch); a draft route passes `noindex, nofollow`.
  robots?: string;
  // 2026-09 redesign (issue #99): sticky is a route decision, not a viewport
  // one -- only ArticleLayout.astro (the template both article routes share)
  // passes true. Every other caller takes the default and its header scrolls
  // away like the rest of the page.
  stickyHeader?: boolean;
}

const { title, titleIsSiteName, description, markdownHref, structuredData, robots, stickyHeader } =
  Astro.props;
---

<Base
  title={title}
  titleIsSiteName={titleIsSiteName}
  description={description}
  markdownHref={markdownHref}
  structuredData={structuredData}
  robots={robots}
>
  <a
    href="#main"
    class="sr-only font-mono text-small focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-accent-ground focus:px-3 focus:py-2 focus:text-accent-on"
  >
    Skip to content
  </a>

  <div class="flex min-h-dvh flex-col">
    <SiteHeader sticky={stickyHeader} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </div>
</Base>
