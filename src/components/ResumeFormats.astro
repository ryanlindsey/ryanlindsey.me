---
// 02 §1's format bar: "Prefer JSON? Markdown? You're my kind of reader."
// Shipped dark on day 2 because /resume.md, /resume.json and /resume.pdf did
// not exist yet. Task 3 created the first two and Task 5 the third, so all
// three now resolve and the bar is on -- the `SHOW_FORMAT_BAR` flag that used
// to gate it is gone rather than left permanently true. tests/pages.test.ts
// asserts both that /resume links every one of these AND that each target
// answers -- linked and resolving are two different claims.
//
// The 2026-09 redesign (design 1k, issue #108) turned one wrapping line of
// links into a 2x2 grid of buttons and added a fourth. THE FOURTH IS NOT A
// FORMAT: /chat is a page, and it sits here because the question a reader has
// after "you can have this as JSON" is "can I just ask it something", not
// because the résumé serialises into it. It is the filled cell for the same
// reason -- it is the one thing in the grid that answers back.
//
// `data-format-bar` stays on the OUTER element, not on the grid, because it is
// what global.css's `@media print` block hides: on paper the buttons are dead
// ink and the line introducing them is dead ink too.
const FORMATS = [
  { href: '/resume.md', label: 'Markdown' },
  { href: '/resume.json', label: 'JSON' },
  { href: '/resume.pdf', label: 'PDF' },
] as const;

// Outlined in ink rather than in rule: these are buttons, and the 1px rule
// weight is what divides content. `no-underline` is the call site's job --
// global.css underlines every link by default and the primitives issue
// deliberately left "has a border" without a selector of its own.
const BUTTON =
  'px-3 py-2.5 text-center font-mono text-small no-underline focus-visible:outline-offset-2';
---

<div data-format-bar>
  <p class="max-w-[34ch] font-mono text-micro uppercase text-ink-muted">
    Prefer JSON? Markdown? You're my kind of reader.
  </p>
  <div class="mt-4 grid grid-cols-2 gap-3">
    {FORMATS.map((format) => (
      <a href={format.href} class={`${BUTTON} border border-ink text-ink`}>
        {format.label}
      </a>
    ))}
    <a href="/chat" class={`${BUTTON} bg-accent-ground text-accent-on`}>
      Ask my agent
    </a>
  </div>
</div>
