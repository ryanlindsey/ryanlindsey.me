---
import { NAV_LINKS, SYSTEM_LINKS, AGENT_LINKS } from '../lib/nav';
import { getResume } from '../lib/resume-collection';

// The SYSTEM and FOR AGENTS columns were two local consts here until issue
// #101. They are in src/lib/nav.ts now, WITH the paragraphs that used to sit
// in this block explaining them -- why /llms-full.txt is absent, why the MCP
// link is `/mcp` and not the bare origin, why RSS and not /feed.json, and why
// Changelog points at /ops#releases. Nothing was dropped; read it there.
//
// They moved because the mobile overlay (MobileNav.astro) repeats the same
// demoted links in its footer strip, and two components rendering five
// destinations from two hand-kept arrays is how a link gets added to this
// colophon and silently never reaches a phone.
const year = new Date().getFullYear();
const { basics } = await getResume();

// The first three nav entries, expressed as "not the promoted one" rather
// than as NAV_LINKS.slice(0, 3). Both pick the same three links today; only
// this one still picks the right ones if a fifth destination is ever added
// to the nav ahead of /chat. Ask my agent is deliberately absent: issue #99
// promoted it OUT of this footer into the primary nav, and repeating it here
// would quietly undo that.
const siteLinks = NAV_LINKS.filter((link) => link.href !== '/chat');

/**
 * GitHub and LinkedIn are READ from the résumé record rather than typed here.
 *
 * Issue #100 lists both URLs "from the prototype" and spells the LinkedIn one
 * `/in/ryanlindsey`. `src/content/resume/ryan-lindsey.yaml` spells it
 * `/in/ryanclindsey`, with a matching `username: ryanclindsey` beside it, and
 * that record is the source of truth every rendered résumé format reads --
 * HTML, Markdown, JSON and PDF. A design mock mistyping a vanity slug is
 * likelier than the record being wrong in a field that ships four ways, so
 * the record wins, and reading it is what stops the two copies disagreeing
 * again. That is the same rule the issue states for the email address one
 * paragraph earlier; this applies it to the two profiles beside it.
 *
 * Pixelsonly Racing stays a literal. It is a side business rather than one of
 * this person's profiles elsewhere, so `basics.profiles` is not where it
 * lives, and looking it up in `projects` by name would hardcode the name in
 * order to avoid hardcoding the URL. NEVER shorten the label to "Pixelsonly":
 * the brand name is both words. The hostname is a literal identifier and is
 * the one place the short form is correct.
 */
const profileLink = (network: string) => {
  const profile = basics.profiles.find((entry) => entry.network === network);
  return profile ? [{ href: profile.url, label: network }] : [];
};

const elsewhereLinks = [
  ...profileLink('GitHub'),
  ...profileLink('LinkedIn'),
  { href: 'https://pixelsonly.racing', label: 'Pixelsonly Racing' },
  // `basics.email` is optional in the schema, so a record without one renders
  // no Email link rather than a `mailto:undefined`. resumeGaps() already
  // reports the missing field; this surface should not invent an address to
  // cover for it.
  ...(basics.email ? [{ href: `mailto:${basics.email}`, label: 'Email' }] : []),
];

/**
 * The four link columns.
 *
 * `label` is not a lower-cased copy of `heading` by accident. The visible
 * heading is set in capitals because the design sets it that way, and an
 * all-capital string is exactly what a screen reader is liable to spell out
 * letter by letter, so the landmark is named by `aria-label` in ordinary
 * sentence case and the visible <p> is hidden from the accessibility tree.
 * The information reaches both audiences once, in the form each can use.
 *
 * The headings are <p> rather than <h2>, and that is load-bearing in a way
 * worth stating: tests/case-studies.test.ts collects every <h2> on a page and
 * asserts EQUALITY against the fixed 02 §4 case-study shape, so one <h2> in
 * shared chrome would fail every /work/<slug> at once and blame the case
 * study rather than the footer. Site chrome does not belong in a page's
 * document outline regardless; the test is what makes forgetting expensive.
 */
const columns = [
  { heading: 'SITE', label: 'Site', links: siteLinks, mono: false },
  { heading: 'SYSTEM', label: 'System', links: SYSTEM_LINKS, mono: false },
  { heading: 'FOR AGENTS', label: 'For agents', links: AGENT_LINKS, mono: true },
  { heading: 'ELSEWHERE', label: 'Elsewhere', links: elsewhereLinks, mono: false },
];

// Every link that leaves the site opens in a new tab and carries
// rel="noopener". The design says this about the ELSEWHERE column; it is
// applied to every external href in the footer instead, because the MCP
// endpoint and the two build-credit links in the bottom strip leave the site
// by exactly the same door, and a rule that covers three of six external
// links is one the next person has to re-derive. `mailto:` is not an external
// href in this sense -- it opens a mail client, not a tab.
const isExternal = (href: string) => href.startsWith('http');
---

<footer data-site-footer class="mt-24 border-t border-rule">
  <div class="mx-auto max-w-[1440px] px-10 pb-11 pt-9">
    <!--
      The design's grid is `1.7fr repeat(4, minmax(0,1fr))`, and that is what
      runs from `lg` up. Below it the columns stack, which the design does not
      specify and no other issue in this epic owns: the mobile work scoped out
      of the header issue is the nav overlay (design 1c), not this. Five
      columns at 390px is not a styling gap that a later issue tidies, it is
      an unreadable footer on a phone, so the minimum that keeps it legible
      ships with it.
    -->
    <div class="grid gap-9 sm:grid-cols-2 lg:grid-cols-[1.7fr_repeat(4,minmax(0,1fr))]">
      <div>
        <p class="font-display text-subheading text-ink">Ryan Lindsey</p>
        <!--
          Deliberately role-agnostic: no employer, no title, so it does not
          need editing when the role changes. It is the same constraint
          `src/content.config.ts` records beside `resumeSchema` for
          `basics.summary` (00 §5 -- the résumé names the employer in `work`,
          positioning surfaces do not), and this is a positioning surface on
          every page of the site.
        -->
        <p class="mt-3 max-w-[46ch] text-small text-ink-muted">
          Engineering leadership and agentic engineering. I build the instruments that keep an
          organization in step, and I still ship the code.
        </p>
      </div>

      {columns.map((column) => (
        <div>
          <p aria-hidden="true" class="font-mono text-micro text-ink-muted">
            {column.heading}
          </p>
          <nav aria-label={column.label} class="mt-3 flex flex-col items-start gap-2">
            {column.links.map((link) => (
              <a
                href={link.href}
                class={column.mono ? 'font-mono text-small text-ink' : 'text-small text-ink'}
                target={isExternal(link.href) ? '_blank' : undefined}
                rel={isExternal(link.href) ? 'noopener' : undefined}
              >
                {link.label}
              </a>
            ))}
          </nav>
        </div>
      ))}
    </div>

    <div class="mt-7 flex flex-wrap items-baseline justify-between gap-4 border-t border-rule pt-[18px] font-mono text-micro text-ink-muted">
      <span>&copy; {year} RYAN LINDSEY</span>
      <span>
        Built{' '}
        <a
          href="https://github.com/ryanlindsey/ryanlindsey.me"
          target="_blank"
          rel="noopener"
          class="text-accent"
        >
          in the open
        </a>{' '}
        on{' '}
        <a href="https://www.cloudflare.com" target="_blank" rel="noopener" class="text-accent">
          Cloudflare
        </a>
      </span>
    </div>
  </div>
</footer>
