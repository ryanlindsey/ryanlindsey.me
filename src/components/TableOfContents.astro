---
import type { TocNode } from '../lib/toc';

interface Props {
  toc: TocNode[];
  /**
   * The rail's visible heading. `null` renders none, which is what design 1k
   * asks for on /resume: there the rail's first item sits on the same baseline
   * as the first section heading beside it, and a label would push it down.
   */
  label?: string | null;
  /**
   * The nav's accessible name. Defaults to the article wording, which
   * tests/pages.test.ts asserts on /writing/<slug>; /resume passes its own,
   * because "table of contents" describes an article rather than a résumé.
   */
  ariaLabel?: string;
}

const { toc, label = 'Contents', ariaLabel = 'Table of contents' } = Astro.props;

const flatten = (nodes: TocNode[]): TocNode[] =>
  nodes.flatMap((node) => [node, ...flatten(node.children)]);
const count = flatten(toc).length;

/*
 * Restyled by the 2026-09 redesign (design 1g, issue #104); the BEHAVIOUR
 * below the fold is untouched and deliberately so. The handoff records the
 * scroll-spy as approved as-is, and the `<script>` at the bottom of this file
 * carries two comments that each name a real bug -- a symmetric root margin
 * flickering between two headings, and a page scrolled to the very bottom
 * never lighting its last section. Only classes and the active-state rule
 * changed here. `aria-current="true"` stays the mechanism rather than gaining
 * a parallel class, because it is both the accessibility affordance and what
 * tests/pages.test.ts already asserts.
 *
 * What the restyle replaced: the whole nav was `font-mono text-micro
 * uppercase` with the active item in `text-accent` and the label under a
 * `border-t border-accent`. The design puts mono uppercase on the label ONLY
 * and sets the items in the body face at text-small, sentence case, so the
 * rail reads as a list of headings rather than as a second set of labels.
 *
 * The active item is a 2px accent cut in the rail's own 1px rule (each item
 * pulls itself back over that rule with `-ml-px`), and it carries no
 * transition: it is one of the three motion moments this design budgets and
 * the budget spends it as a cut, not an ease. The `transition-colors` and
 * `hover:text-accent` this component used to carry are both gone -- hover
 * recolours nothing anywhere in the redesign.
 *
 * TWO PAGES RENDER THIS NOW (issue #108): the article, from its headings, and
 * /resume, from its four section ids. The résumé's rail is the same pattern
 * and was deliberately not rebuilt beside it -- the script below is worth more
 * than it looks, and a hand-built second copy would arrive without either of
 * the fixes its comments record. What that reuse cost was two optional props,
 * `label` and `ariaLabel`, both defaulting to what the article already said.
 */
const ITEM =
  '-ml-px block border-l-2 border-transparent py-[7px] pr-0 text-small text-ink-muted aria-[current=true]:border-l-accent aria-[current=true]:text-ink';
---

{
  count > 0 && (
    <nav aria-label={ariaLabel} data-toc>
      {label && <p class="font-mono text-micro uppercase text-ink-muted">{label}</p>}
      <ul
        class:list={[
          'flex flex-col gap-0.5 border-l border-rule',
          // The 16px belongs to the label, not to the rail, so a rail without
          // one starts flush with the content beside it rather than an inch
          // below it.
          label && 'mt-4',
        ]}
      >
        {toc.map((node) => (
          <li>
            <a href={`#${node.slug}`} data-toc-link={node.slug} class={`${ITEM} pl-[14px]`}>
              {node.text}
            </a>
            {node.children.length > 0 && (
              <ul class="flex flex-col gap-0.5">
                {node.children.map((child) => (
                  <li>
                    <a
                      href={`#${child.slug}`}
                      data-toc-link={child.slug}
                      class={`${ITEM} pl-[26px]`}
                    >
                      {child.text}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  const links = new Map<string, HTMLAnchorElement>();
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')) {
    const slug = link.dataset.tocLink;
    if (slug) links.set(slug, link);
  }

  if (links.size > 0) {
    const headings = [...links.keys()]
      .map((slug) => document.getElementById(slug))
      .filter((el): el is HTMLElement => el !== null);

    let active = '';
    const setActive = (slug: string) => {
      if (slug === active) return;
      links.get(active)?.removeAttribute('aria-current');
      links.get(slug)?.setAttribute('aria-current', 'true');
      active = slug;
    };

    // The band is the top quarter of the viewport: a heading is "current" once
    // it reaches the top, and stays current until the next one arrives. A
    // symmetric margin makes the highlight flicker between two headings while
    // a short section sits fully on screen.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && entry.target.id) {
            setActive(entry.target.id);
          }
        }
      },
      { rootMargin: '0px 0px -75% 0px', threshold: 0 },
    );

    for (const heading of headings) observer.observe(heading);

    // Scrolled to the very bottom, no heading may be inside the band, so the
    // last section would never light up. Pin it.
    addEventListener(
      'scroll',
      () => {
        if (innerHeight + scrollY >= document.body.offsetHeight - 2) {
          const last = headings.at(-1);
          if (last?.id) setActive(last.id);
        }
      },
      { passive: true },
    );
  }
</script>
