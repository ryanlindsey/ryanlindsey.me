---
import ThemeToggle from './ThemeToggle.astro';
import { NAV_LINKS } from '../lib/nav';

interface Props {
  // Sticky only for the two article routes (writing/[...slug], work/[...slug]
  // by way of ArticleLayout.astro's stickyHeader prop, threaded through
  // Shell.astro) -- every other page's header scrolls away. A prop rather
  // than a media query, because the split is by route, not by viewport.
  sticky?: boolean;
}

const { sticky = false } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header data-site-header class={`border-b border-rule bg-bg${sticky ? ' sticky top-0' : ''}`}>
  <!--
    The flex-wrap mitigation this row carried before the 2026-09 redesign
    (task-13-report.md) is gone, not just restyled. It answered five links
    plus the wordmark not fitting this row's non-shrinkable floor at ~400px
    by wrapping the header to two lines; at four links, with a real mobile
    overlay arriving one issue after this one (the inert toggle button below
    is what it will open), the row no longer needs to wrap. Everything below
    `lg` is out of scope here and stays wrong until that issue lands.
  -->
  <div class="mx-auto flex h-[68px] max-w-[1440px] items-center gap-9 px-10">
    <a href="/" class="font-display text-subheading text-ink">Ryan Lindsey</a>

    <nav aria-label="Primary" class="ml-2 flex items-center gap-[30px]">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
            class="border-b-2 border-transparent py-6 font-mono text-small text-ink-muted aria-[current=page]:border-accent aria-[current=page]:text-ink"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-[14px]">
      <!--
        A placeholder, not a control. Site search is not built -- no overlay,
        no results page, no empty state, and none of those should be
        invented here. A focusable element that does nothing is worse than a
        label, and a screen reader should not be told there is a search on
        this page, so this is a non-interactive <span> (aria-hidden), not a
        <button> or an <input>, and no keyboard handler is bound anywhere in
        this file for the shortcut the chip below advertises.
      -->
      <span
        data-search-placeholder
        aria-hidden="true"
        class="flex w-[260px] items-center gap-2.5 border border-rule px-3 py-2"
      >
        <span class="text-small font-mono text-ink-muted">Search</span>
        <span class="ml-auto border border-rule px-[5px] py-px text-micro font-mono text-ink-muted"
          >⌘K</span
        >
      </span>
      <ThemeToggle />
    </div>

    <!--
      Rendered, not built. The mobile-nav issue right after this one consumes
      this exact button (aria-controls="rl-mobile-menu") as a named
      interface, so it exists now with no script and no matching
      #rl-mobile-menu on the page -- clicking it does nothing. Step 4 puts
      everything below `lg` out of this issue's scope; this button is
      deliberately inert, not an oversight.
    -->
    <button
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="rl-mobile-menu"
      class="border border-rule px-2.5 py-2 font-mono text-micro text-ink lg:hidden"
    >
      Menu
    </button>
  </div>
</header>
