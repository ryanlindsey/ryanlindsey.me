---
import ThemeToggle from './ThemeToggle.astro';
import MobileNav from './MobileNav.astro';
import { NAV_LINKS } from '../lib/nav';

interface Props {
  // Sticky only for the two article routes (writing/[...slug], work/[...slug]
  // by way of ArticleLayout.astro's stickyHeader prop, threaded through
  // Shell.astro) -- every other page's header scrolls away. A prop rather
  // than a media query, because the split is by route, not by viewport.
  sticky?: boolean;
}

const { sticky = false } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<!--
  `z-30` rides with `sticky` and is not decoration. Every sticky box on an
  article page sat at `z-index: auto`, so paint order fell back to tree order
  and the LAST one drew on top -- which is the article's own rails, not this
  header. ArticleLayout.astro's contents rail records the first half of that
  bug (at `top: 32px` it drew straight over this row, and moving it to 96px
  hid it for most of a scroll); the half 96px does not fix is the bottom of
  the page, where a sticky element is pushed up by the end of its container
  and a tall contents rail lands back inside this row's band. OBSERVED
  (2026-09-13) at the foot of /writing/armature: the word CONTENTS printed
  under the wordmark. A stacking level here fixes both halves at the source,
  because a header cannot be drawn over by something it out-ranks.

  Chosen to sit under MobileNav.astro's z-50 overlay and over
  ReadingProgress.astro's z-20 bar. The overlay is INSIDE this element, so
  once `sticky` makes this a stacking context the overlay's own z-50 is
  scoped to it and resolves to this level against the page -- still above the
  bar and the article, which is all it has to clear.
-->
<header data-site-header class={`border-b border-rule bg-bg ${sticky ? 'sticky top-0 z-30' : ''}`}>
  <!--
    The flex-wrap mitigation this row carried before the 2026-09 redesign
    (task-13-report.md) is gone, not just restyled. It answered five links
    plus the wordmark not fitting this row's non-shrinkable floor at ~400px
    by wrapping the header to two lines; at four links, with a real mobile
    overlay (design 1c, issue #101, MobileNav.astro below), the row no longer
    needs to wrap because below `lg` it is no longer this row. The sentence
    that used to end this paragraph -- "everything below `lg` is out of scope
    here and stays wrong until that issue lands" -- was true of issue #99 and
    is what issue #101 came back and finished.

    The swap is one breakpoint, spelled three times: the nav and the right
    cluster are `hidden lg:flex`, the toggle is `lg:hidden`, and the row is
    60px tall below `lg` and 68px at it. `lg` is 64rem, and src/lib/mobile-nav.ts
    matches that number in a media query for the same swap -- the two have to
    agree.
  -->
  <!--
    max-w-[1440px] px-10 is the redesign's own target geometry for this row --
    a 1440px cap and a 40px gutter -- and it does not match the rest of the
    page yet. Written when nothing else did: the sentence here used to name
    SiteFooter.astro alongside every page body as still carrying the
    pre-redesign max-w-5xl px-6. The footer stopped being one of them in
    issue #100 and is now capped and guttered exactly like this row, so the
    wordmark and the copyright line beneath it do align. Page bodies still do
    not, from roughly 1090px up. That remaining gap is transitional, not a
    bug: the later page issues in this epic widen the rest of the site to meet
    this width, the way the mobile toggle button below is commented as
    provisional rather than fixed.
  -->
  <!--
    The 20px gutter below `lg` is the design's, not a guess: design 1c sets
    the overlay's own footer strip at `padding: 18px 20px 26px`, so 20px is
    what that view gutters at, and the collapsed header lines up with the
    overlay that replaces it. 40px from `lg` up, as everywhere else.
  -->
  <div class="mx-auto flex h-[60px] max-w-[1440px] items-center gap-9 px-5 lg:h-[68px] lg:px-10">
    <a href="/" class="font-display text-subheading text-ink">
      Ryan Lindsey
    </a>

    <nav aria-label="Primary" class="ml-2 hidden items-center gap-[30px] lg:flex">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          aria-current={isCurrent(link.href) ? 'page' : undefined}
          class="border-b-2 border-transparent py-6 font-mono text-small text-ink-muted aria-[current=page]:border-accent aria-[current=page]:text-ink"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto hidden items-center gap-[14px] lg:flex">
      <!--
        A placeholder, not a control. Site search is not built -- no overlay,
        no results page, no empty state, and none of those should be
        invented here. A focusable element that does nothing is worse than a
        label, and a screen reader should not be told there is a search on
        this page, so this is a non-interactive <span> (aria-hidden), not a
        <button> or an <input>, and no keyboard handler is bound anywhere in
        this file for the shortcut the chip below advertises.
      -->
      <span
        data-search-placeholder
        aria-hidden="true"
        class="flex w-[260px] items-center gap-2.5 border border-rule px-3 py-2"
      >
        <span class="text-small font-mono text-ink-muted">Search</span>
        <span class="ml-auto border border-rule px-[5px] py-px text-micro font-mono text-ink-muted">
          ⌘K
        </span>
      </span>
      <ThemeToggle />
    </div>

    <!--
      Issue #99 shipped this button deliberately inert -- rendered with the
      right `aria-controls` and no script, because the overlay it names was
      the next issue's to build. Issue #101 built it, so the note that used to
      stand here saying "clicking it does nothing" is no longer true: it opens
      MobileNav.astro below, through src/lib/mobile-nav.ts.

      Two 18x2px bars in a 44x44 box. The box is the floor the design sets for
      a hit target and it must not shrink; `h-11 w-11` is 44px and
      tests/mobile-nav.test.ts asserts the spelling, because a rendered page
      cannot be measured from a test but a swap to a smaller utility can be
      seen. The bars are aria-hidden decoration -- the name is on the button.
    -->
    <button
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="rl-mobile-menu"
      class="ml-auto flex h-11 w-11 flex-col items-center justify-center gap-[5px] border border-rule lg:hidden"
    >
      <span aria-hidden="true" class="block h-0.5 w-[18px] bg-ink"></span>
      <span aria-hidden="true" class="block h-0.5 w-[18px] bg-ink"></span>
    </button>
  </div>

  <MobileNav />
</header>
