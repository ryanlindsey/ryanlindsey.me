---
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;

// /about is the one still to come. /ops and /ai-policy have arrived (Day 6
// Task 13) and are appended last, after /resume: they are about the site
// rather than part of reading it.
const links = [
  { href: '/writing', label: 'Writing' },
  { href: '/work', label: 'Work' },
  { href: '/resume', label: 'Resume' },
  { href: '/ops', label: 'Ops' },
  { href: '/ai-policy', label: 'AI Policy' },
];

const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header data-site-header class="border-b border-rule">
  <!-- Day 6 Task 13 fix round: five links plus the wordmark no longer fit
       this row's non-shrinkable floor at ~400px (COMPUTED from the class
       list below, not rendered and measured -- a real visual pass across
       both themes at that width is still owed and unscheduled). `flex-wrap`
       on both this row and the nav is the mitigation: inert at wide widths,
       and it turns what would be sitewide horizontal scroll into a header
       that wraps to two lines instead. -->
  <div class="mx-auto flex max-w-5xl flex-wrap items-baseline justify-between gap-6 px-6 py-5">
    <a href="/" class="font-display text-subheading tracking-tight text-ink hover:text-accent"
      >Ryan Lindsey</a
    >

    <nav aria-label="Primary" class="flex flex-wrap items-baseline gap-6">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
            class="font-mono text-micro uppercase text-ink-muted hover:text-accent aria-[current=page]:text-accent"
          >
            {link.label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>
