---
import { env, waitUntil } from 'cloudflare:workers';
import {
  CACHE_TTL_SECONDS,
  formatCount as count,
  publicToolCalls,
  readOpsReads,
} from '../lib/ops/reads';

/**
 * The five live figures in the home page's system band, rendered as a server
 * island (`server:defer` in src/components/SystemBand.astro).
 *
 * AN ISLAND SO THAT `/` STAYS PRERENDERED. The home page is the busiest route
 * on the site, and the alternative, `prerender = false` on `/`, would give up
 * static-first for five numbers and let AI Search index a day-old count. The
 * island is fetched from `/_server-islands/<id>` after the page loads; a
 * crawler and a visitor without JavaScript see the fallback instead, which has
 * no figures in it on purpose.
 *
 * IT TAKES NO PROPS, AND THAT DOES NOT TAKE THE BUILD KEY OUT OF PLAY. The
 * spec (#434) assumed it did. Read in Astro 7.3.3 on 2026-09-26: the island URL
 * carries `e=`, the component's export name encrypted with the per-build key
 * (node_modules/astro/dist/runtime/server/render/server-islands.js), and the
 * endpoint answers 400 when it cannot decrypt it
 * (node_modules/astro/dist/core/server-islands/endpoint.js). So a copy of `/`
 * built before a deploy asks for an island the new build refuses, and that
 * visitor keeps the fallback.
 *
 * THIS COMMENT FIRST CALLED THAT WINDOW SHORT, because `/` sets no long
 * `Cache-Control` of its own. It was not: on 2026-09-27 the owner saw the
 * fallback's blank tiles on a phone and on a desktop after a cold start, and a
 * refresh filled them. A restored tab can render the HTML it already holds. The
 * fix is an `ASTRO_KEY` fixed across builds, set in Workers Builds, and
 * src/lib/astro-key.mjs fails that build when the variable is missing.
 *
 * THE SAME READS AND THE SAME KV ENTRIES AS /ops, through `readOpsReads`. The
 * two surfaces cannot disagree about a figure for longer than one
 * `CACHE_TTL_SECONDS`, and the next cache-key bump in src/lib/ops/reads.ts
 * moves both. Each value expression below is copied from src/pages/ops.astro's
 * tile of the same label, and the labels were verbatim too, so a reader never
 * met one number under two names.
 *
 * TWO LABELS DEPART FROM /ops SINCE 2026-09-30, by the owner's decision. "Requests
 * through the AI Gateway" is "AI Gateway requests" here and "Requests that
 * reached the Worker" is "Edge compute requests": on `/` the reader is not
 * assumed to know what a Worker is, and /ops, whose point is naming the system
 * behind each figure, keeps both names. The cost is the one the earlier rule
 * avoided, one number under two names, and the tile comments below say which
 * /ops tile each value is copied from so the pair stays findable.
 *
 * ONE ABSENCE FOR ALL FIVE, and no reason beside it. /ops carries three
 * different reasons because it is the page that has room to say which system
 * failed and what that means. The owner's review dropped the provenance line
 * from the band (issue #437), and the first version's "the ops page says why"
 * went with it. The state still says `not available` rather than `0`, which is
 * the rule src/components/OpsMetric.astro exists to keep.
 *
 * ITS OWN TILE, NOT `OpsMetric`, SINCE THE COMPACT REVISION. The band's tile
 * is the case study facts bar's cell, label above value, and `OpsMetric` puts
 * the figure first. Flipping that with a prop would give the shared component
 * an arm /ops never takes, so the band renders the two lines itself and keeps
 * `OpsMetric`'s one contract that tests read: `data-metric-value` on the
 * figure and on the absence alike.
 */

// The same number the KV entries live for, so an intermediary never holds the
// island longer than its figures are fresh. Astro's island endpoint copies the
// headers the component sets and adds `X-Robots-Tag: noindex` itself
// (node_modules/astro/dist/core/server-islands/endpoint.js).
Astro.response.headers.set('Cache-Control', `public, max-age=${CACHE_TTL_SECONDS}`);

const { metrics, traffic, spend } = await readOpsReads(env, new Date(), waitUntil);

/**
 * The gap between one tile's figure rising in and the next, in reading order.
 * global.css's `band-figure-in` owns the animation; this only staggers it.
 */
const REVEAL_STEP_MS = 100;

// Each figure's source is still named on /ops, in the tile of the same label.
const FIGURES: { label: string; value: string | null }[] = [
  {
    label: 'Public MCP tool calls',
    value: count(metrics === null ? null : publicToolCalls(metrics)),
  },
  { label: 'Chat sessions', value: count(metrics?.chatSessions) },
  {
    label: 'Requests from agents',
    value: count(traffic?.agentRequests),
  },
  // /ops: "Requests through the AI Gateway".
  { label: 'AI Gateway requests', value: count(spend?.requests) },
  {
    // /ops: "Requests that reached the Worker".
    label: 'Edge compute requests',
    value: count(traffic?.requests),
  },
];
---

{/*
    NO WRAPPER AROUND THE FIVE, and the grid is why. The island's HTML
    replaces the fallback in place, between Astro's start comment and its
    script (node_modules/astro/dist/runtime/server/render/server-islands.js,
    `replaceServerIsland`), so these cells become direct children of the band's
    grid and take its tracks. One wrapping element would be one grid cell
    holding five tiles.

    `data-band-figure` is the band's own test hook. The classes are
    SystemBand.astro's CELL, LABEL, VALUE and ABSENT, spelled out because
    Tailwind scans each file as text; that file's note says why each is what it
    is, and a change to one belongs in both.
  */}
{FIGURES.map(({ label, value }, index) => (
  <div
    data-band-figure={label}
    class="band-figure-in flex flex-col gap-2 bg-bg px-5 py-[22px] lg:px-6"
    style={`--band-delay: ${index * REVEAL_STEP_MS}ms`}
  >
    <p class="font-mono text-micro uppercase text-ink-muted">{label}</p>
    {value === null ? (
      <p class="mt-auto font-mono text-small leading-6 text-ink-muted" data-metric-value>
        not available
      </p>
    ) : (
      <p
        class="mt-auto font-display text-subheading leading-6 text-ink"
        data-metric-value
        data-numeric
      >
        {value}
      </p>
    )}
  </div>
))}
