---
import type { CollectionEntry } from 'astro:content';

interface Props {
  current: CollectionEntry<'posts'>;
  siblings: CollectionEntry<'posts'>[];
}

const { current, siblings } = Astro.props;
const series = current.data.series;

// Ordered by the author-declared `order`, not by date: a series is a reading
// sequence, and the order it should be read in is not always the order it was
// written in.
const ordered = series
  ? siblings
      .filter((post) => post.data.series?.name === series.name && !post.data.draft)
      .sort((a, b) => (a.data.series?.order ?? 0) - (b.data.series?.order ?? 0))
  : [];

const index = ordered.findIndex((post) => post.id === current.id);
const previous = index > 0 ? ordered[index - 1] : undefined;
const next = index >= 0 && index < ordered.length - 1 ? ordered[index + 1] : undefined;
---

{
  series && ordered.length > 1 && (
    <nav aria-label="Series" data-series-nav class="mt-16 border-t border-rule pt-6">
      <p class="font-mono text-micro uppercase text-ink-muted">
        Part {index + 1} of {ordered.length} in <span class="text-accent">{series.name}</span>
      </p>
      <div class="mt-4 flex flex-wrap justify-between gap-4">
        {previous ? (
          <a
            href={`/writing/${previous.id}`}
            class="font-display text-subheading text-ink hover:text-accent"
          >
            &larr; {previous.data.title}
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a
            href={`/writing/${next.id}`}
            class="text-right font-display text-subheading text-ink hover:text-accent"
          >
            {next.data.title} &rarr;
          </a>
        )}
      </div>
    </nav>
  )
}
