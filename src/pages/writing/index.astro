---
import { getCollection } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import WritingIndex, { WRITING_DESCRIPTION } from '../../components/WritingIndex.astro';

// Drafts never reach an index. `src/pages/writing/[...slug].astro` states the
// convention and keeps their routes; this is the other half of it.
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
---

<Shell title="Writing — Ryan Lindsey" description={WRITING_DESCRIPTION}>
  <WritingIndex posts={posts} />
</Shell>
