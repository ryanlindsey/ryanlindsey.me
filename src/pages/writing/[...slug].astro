---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import { PILLAR_LABELS } from '../../lib/pillars';
import { getResume } from '../../lib/resume-collection';
import { canonicalUrlFor } from '../../lib/markdown-export';
import { buildBlogPosting, buildBreadcrumbList } from '../../lib/structured-data';
import { selectRelated } from '../../lib/related-posts';
import type { GetStaticPaths } from 'astro';

// Drafts get a route but never an index entry, so work in progress is
// shareable by URL without entering the site's navigation. Since launch made
// the sitewide default indexable, "never an index entry" is no longer enough
// on its own -- a draft also passes `noindex, nofollow` below, and
// src/lib/unindexed-routes.mjs keeps it out of the sitemap.
export const getStaticPaths = (async () => {
  const posts = await getCollection('posts');
  // Siblings ride along as props so SeriesNav does not re-query the collection
  // once per rendered page.
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, siblings: posts },
  }));
}) satisfies GetStaticPaths;

const { post, siblings } = Astro.props;
const { Content, headings } = await render(post);

// Task 10 (02 §3): BlogPosting + BreadcrumbList. Built here, not in
// ArticleLayout, per the plan's own ruling on markdownHref (progress.md):
// "prefer the explicit prop over inferring from Astro.url.pathname" -- this
// route already knows it is rendering a post, so it builds the right node
// rather than a shared template guessing collection from the URL.
const resume = await getResume();
const author = { name: resume.basics.name, url: new URL('/', Astro.site).href };
const structuredData = [
  buildBlogPosting({
    headline: post.data.title,
    description: post.data.description,
    url: canonicalUrlFor(post),
    datePublished: post.data.publishedAt,
    dateModified: post.data.updatedAt,
    author,
  }),
  buildBreadcrumbList([
    { name: resume.basics.name, url: new URL('/', Astro.site).href },
    { name: 'Writing', url: new URL('/writing', Astro.site).href },
    { name: post.data.title, url: canonicalUrlFor(post) },
  ]),
];

// The RELATED row (2026-09 redesign, design 1g). Selected here rather than in
// ArticleLayout for the same reason the structured data above is: "same pillar
// where possible" is a rule about 02 §2's post taxonomy, and the layout is
// shared with /work, whose entries have no pillar. `siblings` is already every
// post in the collection -- it rides along as a prop so SeriesNav does not
// re-query -- so this costs no second read. The rule itself, and the reasoning
// for it, live in src/lib/related-posts.ts.
const related = selectRelated(
  siblings.map((sibling) => ({
    href: `/writing/${sibling.id}`,
    title: sibling.data.title,
    kicker: PILLAR_LABELS[sibling.data.pillar] ?? sibling.data.pillar,
    publishedAt: sibling.data.publishedAt,
    pillar: sibling.data.pillar,
    draft: sibling.data.draft,
  })),
  { href: `/writing/${post.id}`, pillar: post.data.pillar },
);
---

<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  kicker={PILLAR_LABELS[post.data.pillar] ?? post.data.pillar}
  body={post.body}
  headings={headings}
  markdownHref={`/writing/${post.id}.md`}
  structuredData={structuredData}
  robots={post.data.draft ? 'noindex, nofollow' : undefined}
  related={related}
>
  <Content />
  <SeriesNav slot="footer" current={post} siblings={siblings} />
</ArticleLayout>
