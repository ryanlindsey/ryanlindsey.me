---
import Shell from '../layouts/Shell.astro';
import ResumeFormats from '../components/ResumeFormats.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { TocNode } from '../lib/toc';
import { getResume } from '../lib/resume-collection';
import { formatDateRange, resumeGaps, groupWorkByCompany } from '../lib/resume';

// Day 3 (02 §1): render from the single validated résumé source instead of
// the day-2 hardcoded skeleton. getResume() reads the `resume` content
// collection and throws ResumeCollectionError unless it contains exactly one
// entry -- this page is what exercises that guard for real (see
// src/lib/resume-collection.ts and tests/pages.test.ts's drift-guard test).
const resume = await getResume();
const gaps = resumeGaps(resume);
// A production page announcing what content it is missing is a worse
// artifact than one that is simply shorter -- the gap notice is a dev-only
// working aid for the content track.
const showGapNotice = import.meta.env.DEV && gaps.length > 0;

// Consecutive `work` entries sharing a `name` render under one company
// heading. groupWorkByCompany lives in src/lib/resume.ts (day 3 Task 3) so
// /resume.md groups identically by construction instead of by agreement, and
// since the 2026-09 redesign it also carries the tenure across the group --
// the number beside the company name, which for a company where several
// titles were held is a span no single role has.
const workGroups = groupWorkByCompany(resume.work);

/*
 * The sticky section rail (design 1k, issue #108). Built as TocNode[] and
 * handed to the article's own TableOfContents rather than to a second rail
 * written here: that component owns the IntersectionObserver, the
 * `aria-current` contract, and two fixes its comments record (a symmetric
 * root margin flickers between headings; a page scrolled to the very bottom
 * never lights its last section). A hand-built copy would have arrived
 * without either of them and nothing would have said so.
 *
 * DERIVED FROM THE SAME CONDITIONS THE SECTIONS THEMSELVES ARE, not from a
 * hardcoded list of four. Projects, Education and Skills each disappear while
 * their array is empty ("no empty scaffolding on any surface", fix round 1),
 * and a rail item pointing at a section that is not on the page is a broken
 * link rather than a missing one.
 */
const sections: TocNode[] = [
  { id: 'experience', text: 'Experience', present: true },
  { id: 'projects', text: 'Projects', present: resume.projects.length > 0 },
  { id: 'education', text: 'Education', present: resume.education.length > 0 },
  { id: 'skills', text: 'Skills', present: resume.skills.length > 0 },
]
  .filter((section) => section.present)
  .map((section) => ({ slug: section.id, text: section.text, children: [] }));

const basedIn = `${resume.basics.location.city}, ${resume.basics.location.region}`;

// The one fact on this page held in two places. `location` in the résumé
// record is the source for the TEXT; this is the article it points at, and
// JSON Resume's `location` has no field for a URL, so putting it in the record
// would mean an `x_`-prefixed extension that /resume.json strips again on the
// way out -- a schema change to carry one string that no consumer would ever
// read.
//
// The duplication is left visible and guarded instead: the test beside this
// page's others derives the expected slug from the record's `city` and fails
// if the two stop agreeing, so a move edits the record and this line together
// rather than leaving the page linking a town nobody lives in.
const BASED_IN_URL = 'https://en.wikipedia.org/wiki/Laguna_Niguel,_California';

// A `tel:` href has to be dialable, and the record stores the number the way a
// person reads it, `(714) 330-6251`. E.164 is the form every dialer accepts
// without guessing, so it is derived here rather than stored a second time --
// the record keeps one spelling of the number and this is the only place it is
// reshaped.
//
// `+1` is written in rather than mapped from `location.countryCode`, which is
// `US` today. A country-code table for a résumé with one owner is scaffolding
// for a move that has not happened; the assumption is worth stating out loud
// instead, so the next reader knows it is an assumption and not a lookup.
const telHref = resume.basics.phone ? `tel:+1${resume.basics.phone.replace(/\D/g, '')}` : null;

// FIX ROUND 2: `/resume` has a `.md` twin (src/pages/resume.md.ts), is named
// in wrangler.jsonc's `run_worker_first`, and src/worker.ts negotiates
// `Accept: text/markdown` for it -- but it passed no `markdownHref`, so it
// was the one content page advertising none of that. Every draft blog post
// emitted `<link rel="alternate" type="text/markdown">`; the résumé, the page
// an agent is most likely to fetch, did not. The prop below is what Base.astro
// turns into that tag, and public/_headers's `/resume/` rule carries the same
// URL in `X-Markdown-Variant` -- the header and the tag must never disagree.

// TITLE WAS `Resume — ${resume.basics.name}` until issue #153 (epic #150).
// Base.astro now appends the site name to every title itself, and MEASURED
// 2026-09-13, `resume.basics.name` reads "Ryan Lindsey" -- the exact string
// Base.astro's suffix appends -- so the two were building the same tail
// independently. Left as it was, this page would have rendered "Resume — Ryan
// Lindsey — Ryan Lindsey"; this file was not in the issue's own list of
// hand-applied copies and was found only by auditing every `title=` prop
// under src/pages.
const SECTION_HEADING = 'border-b border-rule pb-3 font-display text-heading text-ink';
---

<Shell title="Resume" description={resume.basics.summary} markdownHref="/resume.md">
  <div data-testid="resume">
    {showGapNotice && (
      <div
        data-gap-notice
        class="mx-auto mt-10 max-w-[1440px] border border-warn px-4 py-3 font-mono text-small text-warn lg:px-10"
      >
        <p class="text-micro uppercase tracking-wide">Dev only — résumé gaps</p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          {gaps.map((gap) => (
            <li>{gap}</li>
          ))}
        </ul>
      </div>
    )}

    {/*
      Full-bleed rather than on the grid inside, so it runs edge to edge like
      the header's. That is what the 1440px cap and the 40px gutter on the
      inner element are for, and it has not changed.

      1px SINCE 2026-09-13, A DEPARTURE FROM design 1k, which draws 2px. Built
      at 2px to match the handoff and the epic's global constraint, which reads
      "1px --rl-rule to divide, 2px --rl-ink to close a masthead". Changed on
      review: at 2px, full width, near-black on near-white, the line read as a
      bar across the page rather than as a closing rule, in both themes.

      --rl-rule SINCE 2026-09-13 TOO, ON A SECOND REVIEW, AND THE FIRST REVIEW'S
      REASONING FOR KEEPING INK WAS WRONG. It argued: "the colour is what tells
      it apart from the dozens of hairlines below it", and concluded that
      dropping to --rl-rule "would have made this identical to the body
      hairlines, which is the distinction the paragraph above exists to
      protect".

      The error was picking the wrong comparison. This rule is not read against
      the hairlines below it, which are a scroll away and never share the
      viewport with it at rest. It is read against the two immediately above
      it, and both are --rl-rule: SiteHeader.astro's own bottom border, and
      ArticleLayout's `article` masthead shell. Ink made this the only closing
      rule on the site drawn in a different colour from the ones beside it,
      which is what it looked like -- too dark, in both themes.

      The distinction the first review wanted is real and is carried elsewhere:
      the masthead is full-bleed and the body hairlines are not, and the body
      ones sit inside a 1440px cap. Colour was never the only thing doing that
      work. Weight stays at 1px; only the colour moved this time.
    */}
    <section data-resume-masthead class="border-b border-rule">
      <div class="mx-auto grid max-w-[1440px] gap-10 px-5 pb-12 pt-12 lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-16 lg:px-10">
        <div>
          <h1 class="font-display text-display text-ink">{resume.basics.name}</h1>
          <p class="mt-4 font-mono text-subheading uppercase text-accent">{resume.basics.label}</p>
          {/*
            text-large (1.1875rem), the scale's "large body / standfirst" step,
            where the handoff's table asks for `text-body at 1.125rem`. Those
            two are not the same thing and cannot both be had: text-body IS
            1.0625rem. A named step one pixel from the number, at body weight
            and body leading, beats an arbitrary text-[1.125rem] that no other
            page could reuse -- the whole reason the type scale grew named
            steps in the first place (issue #97).
          */}
          <p class="mt-7 max-w-[66ch] text-large text-ink-muted">{resume.basics.summary}</p>
        </div>

        <div class="lg:border-l lg:border-rule lg:pl-10">
          <ResumeFormats />
          <div class="mt-8">
            <p class="font-mono text-micro uppercase text-ink-muted">Based in</p>
            {/*
              `data-based-in` is a styling and test hook rather than decoration.
              global.css's print block appends every external link's raw URL
              through `a[href^='http']::after`, which is right for an article on
              paper and wrong here: it would print the Wikipedia URL inside the
              location field of a sheet 02 §1 requires to be ATS-safe, where a
              parser reading an address is the thing it would corrupt. The rule
              that switches it off is scoped to this attribute.
            */}
            <p data-based-in class="mt-2 text-body text-ink">
              <a href={BASED_IN_URL} target="_blank" rel="noopener">
                {basedIn}
              </a>
            </p>
          </div>

          {/*
            PRINT ONLY, and the sheet is the whole reason it exists. /resume.pdf
            is headless Chrome printing this page (src/lib/resume-pdf.ts), and
            until 2026-09-13 the only thing this column printed was "Based in":
            ResumeFormats carries `data-format-bar`, which global.css's @media
            print block hides. So the PDF stated no way to reach anyone, which
            for the artifact 02 §1 asks to be ATS-safe is the one omission that
            makes the rest of it useless.

            Hidden on screen rather than shown in both places, ruled on review.
            Design 1k's masthead is left as drawn, and the number stays off a
            crawled HTML page. That is about where a scraper trips over it, not
            about whether it is published: /resume.json has carried both fields
            since the 2026-09-07 ruling recorded in the résumé record.

            `hidden print:block` rather than a rule in global.css, because this
            is one page's element and not a site-wide print concern. Tailwind
            emits the print variant after the base utility, so the media query
            wins on paper without either side needing !important.

            DELIBERATELY FLAT -- paragraphs, no nested <div>. Its test slices
            the block with a non-greedy match up to the first `</div>`, so a
            wrapper added in here would silently truncate what that test reads
            and the phone assertion would fail for a reason that has nothing to
            do with the phone.
          */}
          <div data-resume-contact class="hidden print:block">
            {resume.basics.email && (
              <Fragment>
                <p class="mt-8 font-mono text-micro uppercase text-ink-muted">Email</p>
                <p class="mt-2 text-body text-ink">
                  <a href={`mailto:${resume.basics.email}`}>{resume.basics.email}</a>
                </p>
              </Fragment>
            )}
            {resume.basics.phone && telHref && (
              <Fragment>
                <p class="mt-8 font-mono text-micro uppercase text-ink-muted">Phone</p>
                <p class="mt-2 text-body text-ink">
                  <a href={telHref}>{resume.basics.phone}</a>
                </p>
              </Fragment>
            )}
          </div>
        </div>
      </div>
    </section>

    <div
      data-resume-body
      class="mx-auto grid max-w-[1440px] gap-10 px-5 py-14 lg:grid-cols-[220px_minmax(0,1fr)] lg:items-start lg:gap-12 lg:px-10"
    >
      {/*
        lg:top-24 (96px) is global.css's `scroll-padding-top: 6rem`, so a
        clicked rail item lands its heading exactly where the rail is sitting.
        The header does not stick on this page -- that is an article-only prop
        (issue #99) -- so the offset is buying agreement with the anchor scroll
        rather than clearance from anything.

        `lg:items-start` on the grid above is what makes the `sticky` below do
        anything at all, and it is the whole reason ArticleLayout.astro carries
        it too. A grid item stretches to its row by default, so the aside was
        as tall as the entire résumé and had no room to move inside its own
        box: MEASURED before the fix, the rail's top was 4621px above the
        viewport with the page scrolled to the bottom. It reads as sticky at
        the top of the page and silently is not.
      */}
      <aside data-resume-rail class="mb-2 lg:sticky lg:top-24 lg:mb-0">
        <TableOfContents toc={sections} label={null} ariaLabel="Résumé sections" />
      </aside>

      <div>
        <section aria-labelledby="experience">
          <h2 id="experience" class={SECTION_HEADING}>
            Experience
          </h2>
          <ul class="mt-10 flex flex-col gap-12">
            {workGroups.map((group) => (
              <li
                data-employer
                data-company={group.name}
                class="grid gap-6 border-t border-rule pt-[26px] first:border-t-0 first:pt-0 lg:grid-cols-[180px_minmax(0,1fr)] lg:gap-9"
              >
                <div>
                  <h3 class="font-display text-subheading text-ink">{group.name}</h3>
                  {group.location && (
                    <p class="mt-1.5 font-mono text-micro uppercase text-ink-muted">
                      {group.location}
                    </p>
                  )}
                  <p
                    data-tenure
                    data-numeric
                    class="mt-1.5 font-mono text-micro uppercase text-ink-muted"
                  >
                    {formatDateRange(group.startDate, group.endDate)}
                  </p>
                </div>

                <div class="flex flex-col gap-10">
                  {group.roles.map((role) => (
                    <div>
                      <div class="flex flex-wrap items-baseline gap-x-6 gap-y-1">
                        <h4 class="font-display text-subheading text-ink">{role.position}</h4>
                        {/*
                            A company with one title has already printed this
                            exact range as its tenure in the column to the
                            left, and design 1k leaves the role row bare there
                            -- RED Digital Cinema's is the visible case. The
                            handoff's prose says every title carries its dates,
                            but it is describing the multi-title block, and by
                            construction a single-role group's tenure IS its
                            role's range. This prints the number once.
                          */}
                        {group.roles.length > 1 && (
                          <p
                            data-numeric
                            class="ml-auto font-mono text-micro uppercase text-ink-muted"
                          >
                            {formatDateRange(role.startDate, role.endDate)}
                          </p>
                        )}
                      </div>
                      {role.highlights.length > 0 && (
                        <ul class="mt-4 flex max-w-[72ch] list-disc flex-col gap-2.5 pl-5 text-body text-ink-muted">
                          {role.highlights.map((highlight) => (
                            <li>{highlight}</li>
                          ))}
                        </ul>
                      )}
                    </div>
                  ))}
                </div>
              </li>
            ))}
          </ul>
        </section>

        {
          // Work Ryan owns outright, kept out of `work` deliberately -- see the
          // `projects` comment in content.config.ts. Same no-empty-scaffolding
          // rule as Education and Skills below.
          resume.projects.length > 0 && (
            <section class="mt-20" aria-labelledby="projects">
              <h2 id="projects" class={SECTION_HEADING}>
                Projects
              </h2>
              <ul class="mt-10 flex flex-col gap-12">
                {resume.projects.map((project) => (
                  <li class="grid gap-6 border-t border-rule pt-[26px] first:border-t-0 first:pt-0 lg:grid-cols-[180px_minmax(0,1fr)] lg:gap-9">
                    <div>
                      <h3 class="font-display text-subheading text-ink">
                        {project.url ? <a href={project.url}>{project.name}</a> : project.name}
                      </h3>
                      {project.roles.length > 0 && (
                        <p class="mt-1.5 font-mono text-micro uppercase text-ink-muted">
                          {project.roles.join(', ')}
                        </p>
                      )}
                      {project.startDate && (
                        <p
                          data-numeric
                          class="mt-1.5 font-mono text-micro uppercase text-ink-muted"
                        >
                          {formatDateRange(project.startDate, project.endDate)}
                        </p>
                      )}
                    </div>
                    <div>
                      <p class="max-w-[72ch] text-body text-ink-muted">{project.description}</p>
                      {project.highlights.length > 0 && (
                        <ul class="mt-4 flex max-w-[72ch] list-disc flex-col gap-2.5 pl-5 text-body text-ink-muted">
                          {project.highlights.map((highlight) => (
                            <li>{highlight}</li>
                          ))}
                        </ul>
                      )}
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          // No empty scaffolding on any surface, HTML included (fix round 1):
          // an empty array means the whole section -- heading included -- is
          // omitted, not just its contents. Comes back on its own once the
          // content track populates `education`.
          resume.education.length > 0 && (
            <section class="mt-20" aria-labelledby="education">
              <h2 id="education" class={SECTION_HEADING}>
                Education
              </h2>
              <ul class="mt-10 flex flex-col gap-12">
                {resume.education.map((entry) => (
                  <li class="grid gap-6 border-t border-rule pt-[26px] first:border-t-0 first:pt-0 lg:grid-cols-[180px_minmax(0,1fr)] lg:gap-9">
                    <div>
                      <h3 class="font-display text-subheading text-ink">{entry.institution}</h3>
                      {entry.startDate && (
                        <p
                          data-numeric
                          class="mt-1.5 font-mono text-micro uppercase text-ink-muted"
                        >
                          {formatDateRange(entry.startDate, entry.endDate)}
                        </p>
                      )}
                    </div>
                    {(entry.studyType || entry.area) && (
                      <p class="max-w-[72ch] text-body text-ink-muted">
                        {[entry.studyType, entry.area].filter(Boolean).join(', ')}
                      </p>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          // Same rule as Education above: comes back on its own once `skills`
          // is populated.
          resume.skills.length > 0 && (
            <section class="mt-20" aria-labelledby="skills">
              <h2 id="skills" class={SECTION_HEADING}>
                Skills
              </h2>
              <ul class="mt-10 flex flex-col gap-12">
                {resume.skills.map((skill) => (
                  <li class="grid gap-6 border-t border-rule pt-[26px] first:border-t-0 first:pt-0 lg:grid-cols-[180px_minmax(0,1fr)] lg:gap-9">
                    <h3 class="font-display text-subheading text-ink">{skill.name}</h3>
                    <p class="max-w-[72ch] text-body text-ink-muted">{skill.keywords.join(', ')}</p>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
    </div>
  </div>

  <script>
    // `data-print-mode` USED TO BE SET HERE and was removed in fix round 2: it
    // was written on `/resume?print` and read by nothing. Task 5 ended up
    // driving the PDF with `page.emulateMediaType('print')` instead (see
    // src/lib/resume-pdf.ts's `browserRenderer`), which makes the real
    // `@media print` rules in global.css and tokens.css apply -- so the
    // attribute was advertising a styling hook that did not exist. `?print` is
    // still the URL Browser Run navigates to (`RESUME_PRINT_PATH`); it just
    // does not need this page's help to mean anything.

    // Day 3 Task 5: the readiness signal Browser Run waits on before calling
    // page.pdf(). document.fonts.ready is the only deterministic "this page is
    // actually painted in its real typefaces" event -- networkidle0 and
    // waitForFonts are both heuristics that can fire while the fallback face
    // is still on screen, which is the documented top cause of a PDF that
    // renders but looks wrong.
    //
    // Set with setAttribute rather than `dataset.resumeReady`, per the day-2
    // ruling: a data-* contract has to stay greppable at every write site, and
    // `dataset.resumeReady` does not contain the string the selector uses.
    // The attribute is on <html>, not on the résumé container, because it is a
    // statement about the document rather than about the résumé.
    document.fonts.ready.then(() => {
      document.documentElement.setAttribute('data-resume-ready', '1');
    });
  </script>
</Shell>
