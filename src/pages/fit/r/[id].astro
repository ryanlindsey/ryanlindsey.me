---
import { env } from 'cloudflare:workers';
import Shell from '../../../layouts/Shell.astro';
import CampaignBand from '../../../components/CampaignBand.astro';
import { FitReport } from '../../../lib/fit/schema';
import { readCampaignForAudience } from '../../../lib/tier/campaigns';

/**
 * A fit report's permalink (04 §2): a link the reader can pass along to
 * someone who never had a token of their own -- UNSIGNED by design, with the
 * id itself as the capability rather than a signature over it. 128 bits from
 * the CSPRNG, stored in D1, never derived from the report; see `newReportId`
 * in src/lib/fit/client.ts.
 *
 * No token is required, deliberately. The whole purpose of the permalink is
 * that it can be forwarded to people who do not have one, and requiring the
 * token would make the feature the thing it was built to replace.
 *
 * `Shell` rather than the bare `Base` this page used until now. The argument
 * that kept /fit off the site chrome was about a URL carrying a token, and
 * THIS URL CARRIES NONE -- the id is the capability and there is no query
 * string to withhold. It is also the surface read by the most people who have
 * never seen the rest of the site, since it is built to be forwarded on, so
 * it is the page with the least reason of the two to be a dead end.
 *
 * `referrer` stays `strict-origin` all the same. The id in this path is the
 * capability, so a `Referer` carrying the path IS the credential; nothing on
 * this page loads a cross-origin subresource today, and that is not a
 * property to leave resting on nobody adding one.
 */
export const prerender = false;

const { id } = Astro.params;

/**
 * `target_description` is deliberately NOT selected (fix round 1, finding
 * 5). It is in the table (migrations/0002_private_tier.sql), it is typed on
 * this SELECT's row shape in the original brief, and it is never rendered --
 * pure dead weight on every read. Leaving it selected but unrendered would
 * be one accidental `{row.target_description}` away from a real disclosure:
 * that column holds whatever text the submitter pasted, and this permalink
 * is designed to be forwarded to people holding no token, so rendering it
 * would show that text to everyone who receives the link. Whether that
 * should ever happen is a product decision this plan never made; dropping
 * the column from the query needs no such decision and forecloses the
 * accident instead of trusting nobody adds the line.
 *
 * `audience` IS now selected (04 §3), and the paragraph above is not a rule
 * against selecting anything new -- it is specific to `target_description`,
 * whose whole risk was rendering submitter-pasted text verbatim. `audience`
 * carries no such text: `src/pages/fit/run.ts` writes it from the grant that
 * created the row, it is a short label an operator assigns per campaign, and
 * it is never rendered directly -- only fed to `readCampaignForAudience`
 * below, which resolves it into a hero line already written to be shown to a
 * stranger (see the note beside `CampaignBand` further down).
 */
const row = await env.DB.prepare(
  `SELECT created_at, audience, model, report_json, citations_checked, citations_dropped
     FROM fit_reports WHERE id = ?`,
)
  .bind(id ?? '')
  .first<{
    created_at: string;
    audience: string;
    model: string;
    report_json: string;
    citations_checked: number;
    citations_dropped: number;
  }>();

if (row === null) {
  /**
   * A BARE 404 -- no body, no headers. Task 13's `/fit` gates learned this the
   * hard way (src/pages/fit/index.astro, src/pages/fit/run.ts): src/worker.ts
   * flattens every 403/404/500 on the `/fit` prefix into the site's own 404
   * page, fetched rather than reconstructed, so anything this route adds here
   * (a body, `X-Robots-Tag`, ...) is either overwritten or dead weight. A
   * response that differed from what an unrouted path returns would be a
   * route-existence oracle -- confirming to anyone holding a dead or
   * never-issued id that `/fit/r/<id>` is a real route worth guessing at.
   */
  return new Response(null, { status: 404 });
}

/**
 * Parses and validates the stored `report_json`, folding two distinct
 * failure modes into one outcome: JSON that will not even parse, and JSON
 * that parses but no longer matches `FitReport` (a schema change that shipped
 * before this row did). Both are "this row cannot be trusted to render" --
 * and 04 §2's rule that binds this task is that neither may throw. An
 * uncaught exception here becomes a 500, which src/worker.ts's flattening
 * turns into a silent 404: a reader who was sent a working link would see
 * "page not found" for what was actually a stale-but-real report. Returning
 * `null` instead lets the template render a notice -- 200, honest, and
 * actionable ("run a new one").
 *
 * The row was written by THIS build (src/pages/fit/run.ts always
 * `JSON.stringify`s a report that has already passed this same schema), so a
 * parse failure here would itself be surprising -- but the alternative to
 * checking is a page that crashes on a row it did not expect, and reading
 * this table is not the place to assume the write path never changes under
 * it.
 */
function parseStoredReport(json: string): FitReport | null {
  let raw: unknown;
  try {
    raw = JSON.parse(json);
  } catch {
    return null;
  }
  const parsed = FitReport.safeParse(raw);
  return parsed.success ? parsed.data : null;
}

/**
 * The `generated` date label, guarded the same shape as `parseStoredReport`
 * above and for the adjacent reason (fix round 1, finding 4): `created_at`
 * is written by THIS build alone, and unlike `report_json` it carries no
 * schema-versioning story -- but `toISOString()` on an `Invalid Date` THROWS
 * a `RangeError` rather than degrading, where `JSON.parse` at least fails in
 * a shape a `try`/`catch` expects. `generated` is computed before the
 * `report === null` branch decides which half of the template to render, so
 * an unguarded throw here would crash the STALE-SCHEMA NOTICE PATH too --
 * the one adjustment 2 exists to keep alive -- not only the normal render.
 * `Number.isNaN(date.getTime())` is the check that never throws;
 * `toISOString()` is the one that can, so it only runs once that check has
 * passed.
 */
function dateLabel(value: string): string {
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? 'an unknown date' : date.toISOString().slice(0, 10);
}

const report = parseStoredReport(row.report_json);
const generated = dateLabel(row.created_at);

/**
 * The campaign band (04 §3), resolved here rather than carried on a grant --
 * THIS PAGE HAS NO GRANT. Every other `/fit` surface reads `context.heroLine`
 * off `grantContext`, already gated on `campaign?.status === 'active'`
 * (workers/mcp/src/grant-context.ts); this route has no token to resolve into
 * a grant at all, so it is the first site-side code to read a `campaign:`
 * entry directly, keyed by the audience `row.audience` recorded when the run
 * that produced this report was made.
 *
 * `status === 'active'` IS GATED HERE, not inside `readCampaignForAudience`
 * (src/lib/tier/campaigns.ts): that function's own docblock explains at
 * length why it reads `status` nowhere -- it also resolves the preload and the
 * gated narrative document, and a `retired` campaign is meant to keep serving
 * those. This call site wants only the hero line, so it applies the same gate
 * `grant-context.ts` applies on the token-bearing surfaces, matching their
 * behavior rather than reaching into a function that deliberately does not
 * apply it itself.
 *
 * SHOWN TO A STRANGER, BY DESIGN, AND THAT IS ACCEPTABLE (recorded
 * 2026-09-18). This permalink carries no token and is built to be forwarded
 * past the reader who first received it (see the docblock at the top of this
 * file) -- so whatever the band shows here reaches people this feature never
 * authenticated at all. That is the same audience `withCampaignHero`
 * (src/lib/tier/hero-band.ts) already renders one off an attacker-forgeable
 * `Referer` -- a value trivially forged by whoever sends the request -- and
 * it is acceptable here for the identical reason: 09 §1 requires a
 * `hero_line` to carry no company name, which is what makes the string
 * harmless to a stranger rather than a disclosure. This page adds no
 * separate check for that property -- there is nothing to add, since the
 * property already has to hold for the referrer-matched band to be safe, and
 * the same stored string is what both surfaces render.
 */
const campaign = await readCampaignForAudience(env, row.audience);
const heroLine = campaign?.status === 'active' ? campaign.heroLine : '';
---

<Shell
  title="Fit report"
  robots="noindex, nofollow"
  referrer="strict-origin"
  description="A structured comparison against Ryan Lindsey's published record."
>
  {/*
    OUTSIDE THE `div` BELOW, deliberately, the same placement
    src/pages/fit/index.astro uses and for the same reason: the band is
    full-bleed with its own `border-b`, where the `div`'s columns are
    constrained by `max-w-[1440px]` and padded on top of that.

    RENDERED ON THE STALE-SCHEMA NOTICE PATH TOO -- `report === null` decides
    the section below, not whether this renders. The band is about the
    context the run happened in, the same reason the provenance section
    (further down) renders on that path as well; whether today's schema can
    parse `report_json` says nothing about whether that context is worth
    showing.
  */}
  <CampaignBand line={heroLine} />

  {/* A `div`, not a `main`: Shell.astro renders the one `<main id="main">`
      this page has, and the skip link at the top of every page targets it. */}
  <div class="mx-auto w-full max-w-[1440px]">
    <section class="border-b border-rule px-5 pb-9 pt-10 lg:px-10 lg:pt-11">
      <p class="font-mono text-micro uppercase text-accent">Fit report &middot; {generated}</p>
      {report === null ? (
        <>
          <h1 class="mt-4 font-display text-title text-ink">This report cannot be displayed</h1>
          <p class="mt-6 max-w-[68ch] text-large text-ink-muted">
            It was generated by an earlier version of the analyser. Run a new one from the link you
            were sent.
          </p>
        </>
      ) : (
        <>
          <h1 class="mt-4 font-display text-title text-ink">The read</h1>
          <p class="mt-6 max-w-[68ch] text-large text-ink-muted">{report.overall_read}</p>
        </>
      )}
    </section>

    {/*
      Provenance, above the report rather than below it. It was a 12px footer
      until this change, which is a promise the reader had to scroll past the
      whole argument to check. Shown even on the stale-schema notice: the
      numbers are about the ANALYSIS RUN, not about whether today's schema can
      render this row, so a reader is owed them either way.
    */}
    <section data-fit-provenance class="border-b border-rule px-5 py-6 lg:px-10">
      <dl class="flex flex-wrap gap-x-12 gap-y-4 font-mono text-small">
        <div>
          <dt class="text-micro uppercase text-ink-muted">Model</dt>
          <dd class="mt-1 text-ink">{row.model}</dd>
        </div>
        <div>
          <dt class="text-micro uppercase text-ink-muted">Citations checked</dt>
          <dd class="mt-1 text-ink" data-numeric>
            {row.citations_checked}
          </dd>
        </div>
        <div>
          <dt class="text-micro uppercase text-ink-muted">Dropped as unresolvable</dt>
          <dd class="mt-1 text-ink" data-numeric>
            {row.citations_dropped}
          </dd>
        </div>
      </dl>
    </section>

    {report !== null && (
      <div class="px-5 pb-16 lg:px-10">
        <h2 class="mt-12 font-mono text-micro uppercase text-ink-muted">
          Requirement by requirement
        </h2>
        <div class="mt-4 border-t border-rule">
          {report.requirement_map.map((entry) => (
            <section
              data-strength={entry.strength}
              class="grid gap-2 border-b border-rule py-5 sm:grid-cols-[110px_minmax(0,1fr)] sm:gap-6"
            >
              <p
                class:list={[
                  'font-mono text-micro uppercase',
                  entry.strength === 'strong' && 'text-ok',
                  entry.strength === 'partial' && 'text-warn',
                  entry.strength === 'none' && 'text-danger',
                ]}
              >
                {entry.strength}
              </p>
              <div>
                <h3 class="text-body text-ink">{entry.requirement}</h3>
                {entry.evidence.length === 0 ? (
                  <p class="mt-2 text-small text-ink-muted">
                    No supporting evidence in the published work.
                  </p>
                ) : (
                  <ul class="mt-2 space-y-2">
                    {entry.evidence.map((item) => (
                      <li class="text-small text-ink-muted">
                        {item.claim}{' '}
                        <a class="text-accent underline" href={item.citation_url}>
                          source
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </section>
          ))}
        </div>

        <h2 class="mt-12 font-mono text-micro uppercase text-ink-muted">Gaps</h2>
        {report.gaps.length === 0 ? (
          <p class="mt-4 text-body text-ink-muted">
            The analyser found none against this description.
          </p>
        ) : (
          <div class="mt-4 border-t border-rule">
            {report.gaps.map((gap) => (
              <div class="grid gap-2 border-b border-rule py-5 sm:grid-cols-[110px_minmax(0,1fr)] sm:gap-6">
                <p class="font-mono text-micro uppercase text-danger">Gap</p>
                <p class="text-body text-ink-muted">
                  <strong class="text-ink">{gap.requirement}</strong> &mdash; {gap.why}
                </p>
              </div>
            ))}
          </div>
        )}

        <h2 class="mt-12 font-mono text-micro uppercase text-ink-muted">Questions worth asking</h2>
        <ul class="mt-4 max-w-[68ch] list-disc space-y-2 pl-5">
          {report.questions_to_ask.map((question) => (
            <li class="text-body text-ink-muted">{question}</li>
          ))}
        </ul>

        <p class="mt-14 max-w-[68ch] border-t border-rule pt-4 font-mono text-micro text-ink-muted">
          Verify any claim by opening its source, or interrogate the same engine over MCP at
          https://mcp.ryanlindsey.me/mcp.
        </p>
      </div>
    )}
  </div>
</Shell>
