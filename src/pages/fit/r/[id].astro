---
import { env } from 'cloudflare:workers';
import Base from '../../../layouts/Base.astro';
import { FitReport } from '../../../lib/fit/schema';

/**
 * A fit report's permalink (04 §2): "a signed permalink so a recruiter can
 * circulate it internally" -- with the id itself as the capability rather
 * than a signature over it. 128 bits from the CSPRNG, stored in D1, never
 * derived from the report; see `newReportId` in src/lib/fit/client.ts.
 *
 * No token is required, deliberately. The whole purpose of the permalink is
 * that it can be forwarded to people who do not have one, and requiring the
 * token would make the feature the thing it was built to replace.
 */
export const prerender = false;

const { id } = Astro.params;

const row = await env.DB.prepare(
  `SELECT created_at, model, target_description, report_json, citations_checked, citations_dropped
     FROM fit_reports WHERE id = ?`,
)
  .bind(id ?? '')
  .first<{
    created_at: string;
    model: string;
    target_description: string;
    report_json: string;
    citations_checked: number;
    citations_dropped: number;
  }>();

if (row === null) {
  /**
   * A BARE 404 -- no body, no headers. Task 13's `/fit` gates learned this the
   * hard way (src/pages/fit/index.astro, src/pages/fit/run.ts): src/worker.ts
   * flattens every 403/404/500 on the `/fit` prefix into the site's own 404
   * page, fetched rather than reconstructed, so anything this route adds here
   * (a body, `X-Robots-Tag`, ...) is either overwritten or dead weight. A
   * response that differed from what an unrouted path returns would be a
   * route-existence oracle -- confirming to anyone holding a dead or
   * never-issued id that `/fit/r/<id>` is a real route worth guessing at.
   */
  return new Response(null, { status: 404 });
}

/**
 * Parses and validates the stored `report_json`, folding two distinct
 * failure modes into one outcome: JSON that will not even parse, and JSON
 * that parses but no longer matches `FitReport` (a schema change that shipped
 * before this row did). Both are "this row cannot be trusted to render" --
 * and 04 §2's rule that binds this task is that neither may throw. An
 * uncaught exception here becomes a 500, which src/worker.ts's flattening
 * turns into a silent 404: a reader who was sent a working link would see
 * "page not found" for what was actually a stale-but-real report. Returning
 * `null` instead lets the template render a notice -- 200, honest, and
 * actionable ("run a new one").
 *
 * The row was written by THIS build (src/pages/fit/run.ts always
 * `JSON.stringify`s a report that has already passed this same schema), so a
 * parse failure here would itself be surprising -- but the alternative to
 * checking is a page that crashes on a row it did not expect, and reading
 * this table is not the place to assume the write path never changes under
 * it.
 */
function parseStoredReport(json: string): FitReport | null {
  let candidate: unknown;
  try {
    candidate = JSON.parse(json);
  } catch {
    return null;
  }
  const parsed = FitReport.safeParse(candidate);
  return parsed.success ? parsed.data : null;
}

const report = parseStoredReport(row.report_json);
const generated = new Date(row.created_at).toISOString().slice(0, 10);
---

<Base
  title="Fit report"
  robots="noindex, nofollow"
  referrer="no-referrer"
  description="A structured comparison against Ryan Lindsey's published record."
>
  <main class="mx-auto max-w-3xl px-6 py-16">
    <p class="mb-6 border-t border-accent pt-3 font-mono text-micro uppercase text-accent">
      Fit report &middot; {generated}
    </p>

    {
      report === null ? (
        <p class="text-ink-muted">
          This report was generated by an earlier version of the analyser and cannot be displayed.
          Run a new one from the link you were sent.
        </p>
      ) : (
        <>
          <h1 class="font-display text-heading text-ink">The read</h1>
          <p class="mt-4 text-ink">{report.overall_read}</p>

          <h2 class="mt-14 font-display text-subheading text-ink">Requirement by requirement</h2>
          <div class="mt-6 space-y-8">
            {report.requirement_map.map((entry) => (
              <section class="border-t border-rule pt-4">
                <p class="font-mono text-micro uppercase text-accent">{entry.strength}</p>
                <h3 class="mt-1 text-ink">{entry.requirement}</h3>
                {entry.evidence.length === 0 ? (
                  <p class="mt-2 text-small text-ink-muted">
                    No supporting evidence in the corpus.
                  </p>
                ) : (
                  <ul class="mt-2 space-y-2">
                    {entry.evidence.map((item) => (
                      <li class="text-small text-ink-muted">
                        {item.claim}{' '}
                        <a class="text-accent underline" href={item.citation_url}>
                          source
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            ))}
          </div>

          <h2 class="mt-14 font-display text-subheading text-ink">Gaps</h2>
          {report.gaps.length === 0 ? (
            <p class="mt-4 text-ink-muted">The analyser found none against this description.</p>
          ) : (
            <ul class="mt-4 space-y-3">
              {report.gaps.map((gap) => (
                <li class="text-ink-muted">
                  <strong class="text-ink">{gap.requirement}</strong> &mdash; {gap.why}
                </li>
              ))}
            </ul>
          )}

          <h2 class="mt-14 font-display text-subheading text-ink">Questions worth asking</h2>
          <ul class="mt-4 list-disc space-y-2 pl-5">
            {report.questions_to_ask.map((question) => (
              <li class="text-ink-muted">{question}</li>
            ))}
          </ul>
        </>
      )
    }

    {
      /*
      Provenance, on the page rather than in a log. 03 §4 makes the honesty
      contract a promise to the READER, and a reader cannot check a promise
      whose numbers they cannot see -- especially the dropped count, which is
      the one that says whether the analyser was caught inventing a source.
      Shown unconditionally, even on the stale-schema notice above: the
      numbers are about the ANALYSIS RUN, not about whether today's schema can
      still render its `report_json`, so a reader is owed them either way.
    */
    }
    <footer class="mt-16 border-t border-rule pt-4 font-mono text-micro text-ink-muted">
      <p>
        Generated {generated} by {row.model}. {row.citations_checked} citation{
          row.citations_checked === 1 ? '' : 's'
        } checked against the published corpus, {row.citations_dropped} dropped as unresolvable.
      </p>
      <p class="mt-2">
        Verify any claim by opening its source &mdash; or interrogate the same engine over MCP at
        https://mcp.ryanlindsey.me/mcp.
      </p>
    </footer>
  </main>
</Base>
