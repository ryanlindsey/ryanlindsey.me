---
import { env } from 'cloudflare:workers';
import Shell from '../../layouts/Shell.astro';
import Turnstile from '../../components/Turnstile.astro';
import CampaignBand from '../../components/CampaignBand.astro';
import { grantContext } from '../../lib/fit/client';
import { fitErrorCopy } from '../../lib/fit/errors';

/**
 * The fit analyser (04 §2). UNLISTED: absent from nav, from the sitemap and
 * from /llms.txt, reachable only with a token that carries the `fit` scope.
 *
 * On-demand rather than prerendered, for the obvious reason (it reads a token
 * off the query string) and a less obvious one: a prerendered Astro endpoint
 * has its Response headers discarded at build time, and this page's
 * `Referrer-Policy` is not decorative -- the token is in this URL.
 *
 * `Shell` NOW, AND IT WAS `Base` UNTIL THIS CHANGE. The sentence that stood
 * here is kept verbatim because half of it is still true: "the site header is
 * a nav, and an unlisted page has no business rendering the index it is
 * deliberately absent from -- nor linking back into it from a URL that
 * carries a token."
 *
 * The second clause is answered rather than overruled. `referrer` below is
 * `strict-origin`, so a same-origin navigation out of this page sends the
 * origin and nothing after it: no path, no `?t=`. Following the wordmark home
 * cannot carry the token anywhere, which is the same property the Turnstile
 * script already relies on.
 *
 * The first clause was a judgement about audience, and it was decided the
 * wrong way round. UNLISTED IS NOT SEALED: 09 §1 requires this page to be
 * absent from every index the site publishes, and tests/fit-pages.test.ts
 * asserts that against the real documents (/llms.txt, /rss.xml, /robots.txt,
 * the home page) rather than against what this page renders -- so none of it
 * moves when the chrome arrives. Meanwhile src/pages/404.astro DOES use
 * `Shell`, and src/worker.ts serves that exact page for every ungranted
 * `/fit`: a visitor with a bad token already got the whole site, and only a
 * visitor holding a GOOD one got a page with no way out of it. The asymmetry
 * ran backwards.
 */
export const prerender = false;

const token = Astro.url.searchParams.get('t') ?? '';

/**
 * The access check, and the ONLY one on this page. Delegated to the MCP
 * Worker: `analyze_fit` is registered only for a grant carrying the `fit`
 * scope, so its presence in the granted tool list is the whole statement --
 * signature, expiry, registration and revocation, all evaluated by the code
 * that owns them.
 *
 * 404, not 403. A 403 would confirm that this page exists to anyone holding
 * the URL, which is exactly what an unlisted surface must not do.
 */
const context = token === '' ? null : await grantContext(env, token);
if (context === null || !context.tools.has('analyze_fit')) {
  // A BARE 404, which src/worker.ts replaces with the site's own 404 page
  // before it reaches the client. That indirection is the fix for a real
  // finding: what a prober compares is not the status but the whole response,
  // and this page cannot produce the site's 404 itself. `Astro.rewrite('/404')`
  // was tried first and MEASURED at 500 -- an on-demand route cannot rewrite to
  // a prerendered one -- so the worker, which can dispatch a second request,
  // does it. See its `/fit` branch, and src/pages/404.astro for why that page
  // had to exist at all.
  return new Response(null, { status: 404 });
}

/**
 * The preload (04 §2), from THIS grant's campaign rather than from whichever
 * entry happens to be `active`. That is what lets more than one campaign run
 * at once: see workers/mcp/src/grant-context.ts for the defect it closes.
 * With no campaign for this audience there is simply no preload, and the empty
 * state is the one that ships by default.
 */
const preload = context.preload;

/**
 * The expiry, as a date rather than a timestamp. `Grant.expiresAt` is epoch
 * seconds; a reader deciding whether to forward this link needs the day, not
 * the second.
 */
const expiryLabel = new Date(context.expiresAt * 1000).toISOString().slice(0, 10);

/**
 * The refusal to show, LOOKED UP rather than read out of the URL.
 *
 * `?error=` carries a reason CODE (see src/lib/fit/errors.ts), and this page
 * renders only copy it owns. The parameter is attacker-controlled -- a
 * `/fit?t=...` link is meant to be forwarded, so whoever holds one can put
 * anything after `&error=` -- and it used to be rendered verbatim, which made
 * the real origin a delivery mechanism for someone else's sentence
 * (final-review Important 7). An unrecognised code renders nothing at all.
 *
 * This also retires the `decodeURIComponent` hazard the previous comment here
 * recorded: a code from the closed set never contains a literal `%`, so there
 * is no longer a refusal sentence whose own punctuation could crash the page
 * that exists to display it.
 */
const error = fitErrorCopy(Astro.url.searchParams.get('error'));

/**
 * The rail's own type, spelled the way src/pages/chat.astro spells it. That
 * page is this one's nearest sibling -- same grid, same 320px column, same
 * job of explaining an interactive surface beside it -- and the two rails
 * reading differently was most of what made this page look unfinished next to
 * it.
 */
/** A rail block after the first: opened by a rule, the way every rail on this site is. */
const RAIL_BLOCK = 'border-t border-rule pt-[18px]';
const RAIL_HEADING = 'font-mono text-micro uppercase text-ink-muted';
---

<Shell
  title="Fit analysis"
  robots="noindex, nofollow"
  referrer="strict-origin"
  description="Compare a description against Ryan Lindsey's published record."
>
  {/*
    OUTSIDE THE GRID BELOW, DELIBERATELY. The band is full-bleed with its own
    `border-b`, where the grid's own columns are constrained by `max-w-[1440px]`
    and padded on top of that -- nesting it inside would double the inset on
    one side and leave the rule short of the viewport edge. `context.heroLine`
    arrives already resolved and already gated on `campaign?.status ===
    'active'` (workers/mcp/src/grant-context.ts) -- this page checks nothing
    about the campaign itself, only whether the string is non-empty, which is
    `CampaignBand`'s own job.
  */}
  <CampaignBand line={context.heroLine} />

  {/*
    THREE GRID ITEMS RATHER THAN TWO, in the order src/pages/chat.astro
    settled on and for the reason it records: the rail is WRITTEN between the
    masthead and the form, so a reader meets what this does and when the link
    expires on the way to the box rather than after filling it in. Explicit
    row and column placement puts the rail back on the right at `lg`, so the
    reading order and the layout disagree on purpose.

    It was two items until this change, and the phone layout is what that
    cost: headline, then an eighteen-row textarea, then -- below the submit
    button -- the sentence saying when the link expires, which is the one fact
    a reader wants BEFORE deciding to paste anything in.
  */}
  <div class="mx-auto grid w-full max-w-[1440px] lg:grid-cols-[minmax(0,1fr)_320px]">
    <div class="px-5 pt-10 lg:col-start-1 lg:row-start-1 lg:px-10 lg:pt-11">
      <p class="font-mono text-micro uppercase text-accent">Private tier</p>
      {/*
        `text-title` UNDER AN EYEBROW, which is /ops's masthead rather than
        /chat's. /chat banners its headline because it has no eyebrow to carry;
        this page's says PRIVATE TIER, which is the one thing a reader who was
        sent a link needs to know about where they have landed, so the eyebrow
        stays and the headline sits at the scale that pairs with it.
        tests/fit-pages.test.ts pins the scale against a return to the
        pre-redesign steps.
      */}
      <h1 class="mt-4 font-display text-title text-ink">Fit analysis</h1>
      <p class="mt-3 max-w-[64ch] text-ink-muted">
        Paste a description below. The analysis goes requirement by requirement through Ryan's
        published record: every claim cites a page you can open, and the gaps are named as plainly
        as the matches.
      </p>
    </div>

    {/*
      WHAT THIS IS came out of this rail and became the paragraph above. It was
      the longest block here and it answered the question the masthead is the
      place to answer, which left the rail opening on an explanation and the
      headline standing alone over a form. What is left are the three facts a
      reader checks rather than reads: how long the link lasts, where the
      output goes, and how to skip this page entirely.
    */}
    <aside
      data-fit-rail
      class="mt-9 flex flex-col gap-[26px] border-t border-rule px-5 py-9 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:mt-0 lg:border-l lg:border-t-0 lg:px-7 lg:py-11"
    >
      <div>
        <p class={RAIL_HEADING}>This link</p>
        <p class="mt-3 font-mono text-small text-ink">Expires {expiryLabel}</p>
        <p class="mt-2 text-small text-ink-muted">
          It can be forwarded. Anyone holding it can run the analysis until then.
        </p>
      </div>
      <div class={RAIL_BLOCK}>
        <p class={RAIL_HEADING}>The report</p>
        <p class="mt-3 text-small text-ink-muted">
          Each run gets its own address, which needs no link of its own to read. Reports are kept a
          year.
        </p>
      </div>
      <div class={RAIL_BLOCK}>
        <p class={RAIL_HEADING}>Over MCP</p>
        <p class="mt-3 text-small text-ink-muted">
          The same engine runs as the <code>analyze_fit</code> tool, so you can point an agent at it
          instead.
        </p>
        <p class="mt-2 font-mono text-small text-ink">mcp.ryanlindsey.me/mcp</p>
      </div>
    </aside>

    <div class="px-5 pb-12 lg:col-start-1 lg:row-start-2 lg:px-10">
      {error && (
        <p class="mt-9 max-w-[64ch] border-l-2 border-accent bg-accent-ground/10 px-4 py-3 font-mono text-small text-ink">
          {error}
        </p>
      )}

      <form method="POST" action="/fit/run" class="mt-9">
        <input type="hidden" name="t" value={token} />
        <label class="block font-mono text-micro uppercase text-ink-muted" for="target_description">
          The description
        </label>
        <textarea
          id="target_description"
          name="target_description"
          rows="18"
          required
          minlength="200"
          class="mt-3 w-full border border-rule bg-transparent p-4 font-mono text-small text-ink"
          placeholder="Paste the full text here."
        >{preload}</textarea>

        <Turnstile sitekey={env.RLME_TURNSTILE_SITEKEY} />

        <button
          type="submit"
          class="border border-accent px-5 py-3 font-mono text-small uppercase text-accent hover:bg-accent-ground hover:text-accent-on"
        >
          Analyse
        </button>
      </form>
    </div>
  </div>
</Shell>
