                {RETENTION_LABELS[entry.table] ?? entry.table}
              </span>
              <span class="font-mono text-small text-ink" data-numeric>
                {formatWindow(entry.days)}
              </span>
            </li>
          ))}
        </ul>
        <p class="mt-3 font-mono text-micro text-ink-muted">
          A daily job enfores these and the{' '}
          <a class="text-accent" href="/ai-policy">
            policy
          </a>{' '}
          states them.
        </p>
      </section>

      <section aria-labelledby="releases" class={PANEL}>
        <div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
          <h2 id="releases" class={PANEL_HEADING}>
            Release history
          </h2>
        </div>

        {releases.length === 0 ? (
          <p class="mt-6 text-small text-ink-muted">No releases parsed from this build.</p>
        ) : (
          <ul class="mt-6 divide-y divide-rule border-t border-rule">
            {releases.map((release) => (
              <li class="flex items-baseline justify-between gap-6 py-3">
                <span class="font-mono text-small text-ink" data-numeric>
                  {release.version}
                </span>
                <span class="font-mono text-small text-ink-muted" data-numeric>
                  {release.date}
                </span>
              </li>
            ))}
          </ul>
        )}
      </section>
    </div>
  </div>
</Shell>
