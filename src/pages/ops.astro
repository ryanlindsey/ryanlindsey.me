---
import { env } from 'cloudflare:workers';
import Shell from '../layouts/Shell.astro';
import ArchitectureDiagram from '../components/ArchitectureDiagram.astro';
import OpsMetric from '../components/OpsMetric.astro';
import changelog from '../../CHANGELOG.md?raw';
import { CHAT_MODEL } from '../lib/chat/engine';
import { CHAT_ERROR_COPY } from '../lib/chat/errors';
import { CORPUS_EMBEDDING_MODEL } from '../lib/corpus';
import { FIT_MODEL } from '../lib/fit/engine';
import { JUDGE_MODEL } from '../lib/judge/engine';
import { GLOBAL_LIMITS, LIMITS, type ToolCost } from '../lib/mcp/limits';
import {
  readAnalytics,
  readSpend,
  type AgentTraffic,
  type GatewaySpend,
} from '../lib/ops/analytics';
import { cached } from '../lib/ops/cache';
import { recentReleases } from '../lib/ops/changelog';
import { readOpsMetrics, type OpsMetrics } from '../lib/ops/metrics';
import { formatWindow, RETENTION } from '../lib/retention';
import { OPS_CARD } from '../lib/og/cards';

/**
 * The living colophon (06 §1): what this site is, what it has done lately, what
 * it costs, and what it does when a part of it fails.
 *
 * ON-DEMAND, because every figure on it is read at request time. A prerendered
 * /ops would publish the numbers the build machine happened to see, which is
 * the one thing this page must not do.
 *
 * AGGREGATE AND PUBLIC-TIER ONLY (09 §2). No campaign label, no audience, no
 * gated tool name, no per-token figure and no visitor's question renders here.
 * The filtering is done in SQL, one layer down (src/lib/ops/metrics.ts), and is
 * deliberately NOT repeated in this template: a page that receives only public
 * rows cannot leak one by forgetting a condition, while a page that receives
 * everything and filters on render leaks the first time somebody adds a
 * section. Nothing below reads a field the read layer did not already narrow.
 */
export const prerender = false;

/**
 * How long a figure on this page may be, in one place: the KV entries below and
 * the `Cache-Control` header are the same number and must never be two.
 *
 * An intermediary holding the page longer than the cache holds its figures
 * would be publishing numbers this Worker has already replaced.
 */
const CACHE_TTL_SECONDS = 60;

Astro.response.headers.set('Cache-Control', `public, max-age=${CACHE_TTL_SECONDS}`);

/** The window every counted figure on this page is measured over. */
const WINDOW_DAYS = 30;

/**
 * One read, cached under its own key, degrading to `null` on anything that
 * throws.
 *
 * THREE KEYS RATHER THAN ONE, which the plan spelled as a single `ops:v1`. The
 * key shape turned out to be load-bearing in two directions the single entry
 * got wrong, and neither is theoretical:
 *
 *   - IT MISLABELLED WHICH SYSTEM WAS BROKEN. One `try` around all three reads
 *     means a D1 rejection nulls `traffic` and `spend` as well, so the three
 *     Analytics Engine tiles fall through to their default absence -- "this
 *     needs the read-only analytics token" -- which is a FALSE sentence about
 *     what is wrong. That is the exact error `D1_ABSENT` below was invented to
 *     prevent, reintroduced one level up. It is harmless only while the token
 *     is unconfigured and becomes a live falsehood the day it is populated.
 *   - IT AMPLIFIED A D1 OUTAGE INTO AN API ONE. The `try` is outside `cached`
 *     (see below), so a rejection means NOTHING is written -- including the
 *     analytics half that answered perfectly well. Every request during a D1
 *     blip would then re-run `readAnalytics`'s three api.cloudflare.com queries
 *     uncached, against a rate-limited token, which is precisely the
 *     amplification src/lib/ops/cache.ts exists to prevent.
 *
 * Per-key caching also restores the property that module documents and the
 * single entry silently lost: `cached` never stores a bare `null`, so an
 * unconfigured or failed read is retried on the next request rather than pinned
 * as "not configured" for the whole TTL. Folded into a composite object, a
 * `null` half was just a field and was stored with the rest.
 *
 * THE TRY IS AROUND THE CACHE CALL RATHER THAN INSIDE IT, and that placement is
 * still the point. `readOpsMetrics` returns `Promise<OpsMetrics>`, not `| null`,
 * and carries no internal try -- deliberately, since a caller that wants the
 * numbers should hear about a D1 outage rather than receive a shape that looks
 * like zero traffic. This page is the caller, and what it wants is to degrade:
 * an unhandled rejection here is a 500 on a public page whose entire premise is
 * that it tells you what it knows.
 *
 * WHAT THE PLACEMENT DOES NOT BUY, recorded rather than deleted because an
 * earlier version of this comment claimed it did (final-review Minor 6): it is
 * not what keeps a failed read out of the cache. `cached` awaits `fn` before it
 * writes anything, so a rejection leaves the function before the `put` no
 * matter where the caller's `try` sits. Not being pinned is
 * src/lib/ops/cache.ts's own structure, and so is the separate property that a
 * bare `null` is never stored. The 500 is the whole reason this `try` is here.
 */
async function readOrNull<T>(key: string, read: () => Promise<T>): Promise<T | null> {
  try {
    return await cached<T | null>(env.KV_CACHE, key, CACHE_TTL_SECONDS, read);
  } catch (error) {
    // The operator gets the exception in Workers observability; the reader gets
    // a sentence saying that figure is not available. A stack trace on a public
    // page would be both a worse answer and a disclosure.
    console.error(`ops: ${key} could not be read`, error);
    return null;
  }
}

const now = new Date();
const [metrics, traffic, spend]: [OpsMetrics | null, AgentTraffic | null, GatewaySpend | null] =
  await Promise.all([
    // `v2` SINCE ISSUE #291, AND THE BUMP IS THE POINT RATHER THAN THE NUMBER.
    // `OpsMetrics` gained `status` (migrations/0005), and an entry written by
    // the previous build has no such field: `run.status === 'ran'` is false for
    // `undefined`, so every suite in the table would have rendered "did not
    // run" for the whole `CACHE_TTL_SECONDS` after the deploy. The page would
    // have been reporting a broken eval pipeline, from its own cache.
    //
    // THE SAME LESSON, ALREADY LEARNED ONCE HERE. CLAUDE.md records it about
    // `SEARCH_CACHE_VERSION`: `searchCacheKey` is built from the query alone,
    // so nothing in an entry names the shape or the index it came from, and
    // changing what an entry holds without changing the key keeps serving the
    // old one for a full TTL. This key has the same property and the same
    // remedy.
    //
    // `v3` SINCE ISSUE #353, for the same reason a second time. `fitRuns` went
    // from one number to four, and a `v2` entry's bare number has no `reports`
    // on it, so the fit tile would have rendered its absence, and its note
    // "null started", while D1 answered perfectly well. tests/ops-page.test.ts
    // plants an entry under `ops:metrics:v2` and fails if the page serves it.
    readOrNull('ops:metrics:v3', () => readOpsMetrics(env.DB, now, WINDOW_DAYS)),
    readOrNull('ops:traffic:v1', () => readAnalytics(env, now, WINDOW_DAYS)),
    readOrNull('ops:spend:v1', () => readSpend(env, now, WINDOW_DAYS)),
  ]);

/**
 * The absence wording for the uncredentialed half. Different from the default
 * on `OpsMetric` on purpose: when D1 does not answer, the read-only analytics
 * token is not what is missing, and telling a reader to go and configure one
 * would send them after the wrong thing.
 */
const D1_ABSENT = {
  absentState: 'not available',
  absentReason: 'the metrics store could not be read',
};

/**
 * The absence wording for the gateway half.
 *
 * IT NAMES TWO CAUSES BECAUSE THERE ARE AT LEAST SEVEN, and a sentence naming
 * one of them would be this page's own signature defect. `readSpend` returns
 * `null` for an unreadable or empty token, a non-200, a 200 carrying a GraphQL
 * `errors` array, an envelope that is not the measured one, an empty
 * `accounts`, a group count other than one, and any figure that is not finite.
 * Those fall into two classes a reader can act on -- the credential, and a
 * response this build will not read -- so the line names the classes and
 * claims nothing about which.
 *
 * WHAT IT MUST NOT SAY IS THAT SPENDING HAPPENED. An earlier version of the
 * copy below promised a blank tile "is a different statement from nothing
 * having been spent", which src/lib/ops/analytics.ts contradicts in writing: a
 * window with no gateway traffic in it returns an empty groups array, which is
 * deliberately a `null`, because an empty result cannot be told from a wrong
 * filter. So a genuinely quiet month renders exactly like a broken read, and
 * the page has to leave that open rather than rule it out.
 *
 * The previous clause it replaced -- "and the gateway read is unwritten" --
 * went for a simpler reason: it was true of the empty `readSpend` it was
 * written beside, and false the moment that function got its measured parse.
 */
const GATEWAY_ABSENT = {
  absentReason:
    'this needs the read-only analytics token, and a gateway response this build can read',
};

/** A figure with thousands separators, or `null` when there is no figure. */
const count = (value: number | null | undefined): string | null =>
  value === null || value === undefined ? null : value.toLocaleString('en-US');

/** What the fit figure leaves out, as a count of each. */
const fitNote = ({ started, failed, unfinished }: OpsMetrics['fitRuns']): string =>
  `${count(started)} started, ${count(failed)} failed, ${count(unfinished)} not finished`;

const toolCalls =
  metrics === null ? null : metrics.toolCalls.reduce((total, row) => total + row.calls, 0);

/**
 * The three breakdown lists, in the shape the panels below render.
 *
 * THEY EXIST BECAUSE THE QUERIES ALREADY DID. `readAnalytics` has always issued
 * three queries and /ops used to render one of them, so two thirds of a
 * rate-limited token's round trips bought nothing a reader could see
 * (final-review Important 2). Rendering both is what makes the cost honest.
 *
 * `null` ROWS MEAN "COULD NOT BE READ", the same distinction `OpsMetric` draws
 * and with the same words, because a breakdown that simply vanished when the
 * read failed would be indistinguishable from one with nothing in it -- which
 * is the invisible zero in list form.
 *
 * BY TOOL JOINED THIS LIST IN THE 2026-09 REDESIGN AND GAINED AN ABSENCE BY
 * DOING SO. It used to render behind `metrics !== null && toolCalls.length > 0`,
 * so a D1 outage did not degrade that list, it deleted it -- the one failure
 * this page's whole premise is against, and the last breakdown still doing it.
 * It reads from D1 rather than from Analytics Engine, which is why the absence
 * wording is per row here instead of one constant: "this needs the read-only
 * analytics token" is a false sentence about a D1 outage, and telling a reader
 * to go and configure a credential that is not missing is the error `D1_ABSENT`
 * was invented to prevent.
 *
 * NOTHING HERE IS NARROWED IN THE TEMPLATE, per this file's own rule: both
 * analytics label vocabularies are closed in src/lib/agent-intel/classify.ts
 * (`Classification.agent` and `RouteClass`), neither carries raw user-agent
 * text, and src/lib/ops/analytics.ts rejects a row whose label is not a
 * non-empty string before it gets here. `toolCalls` is narrowed in SQL one
 * layer down (src/lib/ops/metrics.ts), which is why no tier test appears in
 * this file.
 */
const BREAKDOWNS: {
  title: string;
  source: string;
  absentState: string;
  absentReason: string;
  rows: { label: string; value: number }[] | null;
}[] = [
  {
    title: 'By tool',
    source: 'D1',
    ...D1_ABSENT,
    rows:
      metrics === null
        ? null
        : metrics.toolCalls.map((row) => ({ label: row.tool, value: row.calls })),
  },
  {
    title: 'By agent',
    source: 'Analytics Engine',
    absentState: 'not configured',
    absentReason: 'this needs the read-only analytics token',
    rows:
      traffic === null
        ? null
        : traffic.byAgent.map((row) => ({ label: row.agent, value: row.requests })),
  },
  {
    title: 'By route class',
    source: 'Analytics Engine',
    absentState: 'not configured',
    absentReason: 'this needs the read-only analytics token',
    rows:
      traffic === null
        ? null
        : traffic.byRouteClass.map((row) => ({ label: row.routeClass, value: row.requests })),
  },
];

/**
 * A bar's width as a percentage of the largest value in its own list.
 *
 * PROPORTIONAL TO THE MAX RATHER THAN THE TOTAL, because each of these lists is
 * the top few rows of a longer tail. Shares of a total that is not shown would
 * not add up to anything a reader could check, and this page does not publish
 * a figure a reader cannot check.
 *
 * The floor of 1 is for that tail. A tool called twice beside a leader called
 * six hundred times rounds to 0% and renders as no bar at all, which reads as
 * "never called" rather than "called rarely" -- the invisible zero again, in
 * bar form. One percent of a cell is a visible sliver and is the honest shape
 * of that row.
 */
function barWidth(value: number, max: number): string {
  if (max <= 0) return '0%';
  return `${Math.max(1, Math.round((value / max) * 100))}%`;
}

/** The largest value in a breakdown, which is what its bars are drawn against. */
const maxValue = (rows: { value: number }[]): number =>
  rows.reduce((largest, row) => Math.max(largest, row.value), 0);

/**
 * Which ramp an eval suite's pass count is set in.
 *
 * `failed === 0` IS THE GREEN TEST, not a pass rate near 1. A suite with one
 * failure is a suite with a failing check in it, and rounding that to green on
 * the grounds that seven of eight passed is how a red suite gets published as
 * a healthy one. The amber band is "some passed", and danger is the majority
 * failing, which is the shape of a suite that could not run properly rather
 * than one with a bad case in it.
 */
function evalTone(passed: number, total: number, failed: number): string {
  if (failed === 0) return 'text-ok';
  return passed / Math.max(1, total) >= 0.5 ? 'text-warn' : 'text-danger';
}

/**
 * A stored timestamp as a date and never a time (10 §1.4). The published rule
 * is that this site does not publish a time of day for the owner's activity,
 * and an eval feed stamped to the minute is a working-hours graph that nobody
 * would think to audit because the numbers are all about software.
 *
 * Guarded the same shape as the fit permalink's own `dateLabel`, and for the
 * same reason: `toISOString()` throws a `RangeError` on an `Invalid Date`, and
 * a row this page did not write is not the place to assume it never will.
 */
function dateOnly(value: string): string {
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? 'an unknown date' : date.toISOString().slice(0, 10);
}

/** A limiter period as the phrase a reader can hold in their head. */
function per(seconds: number): string {
  if (seconds === 60) return 'minute';
  if (seconds === 3_600) return 'hour';
  if (seconds === 86_400) return 'day';
  return `${seconds / 60} minutes`;
}

const limitPhrase = (cost: ToolCost): string =>
  `${LIMITS[cost].limit} per ${per(LIMITS[cost].periodSeconds)}`;

/**
 * The limits this page publishes, and what each one is in English.
 *
 * PUBLIC-TIER CLASSES ONLY. `LIMITS` also carries the `expensive` bucket, which
 * belongs to a token-scoped surface; publishing its cap would say that surface
 * exists and roughly what it costs, on the page most likely to be read by
 * somebody probing for it. The numbers come from the constant either way --
 * this is a choice about which rows to render, never a second copy of one.
 */
const LIMIT_ROWS: { cost: ToolCost; what: string }[] = [
  { cost: 'cheap', what: 'Reading a published document over MCP' },
  { cost: 'inference', what: 'Semantic search over the corpus' },
  { cost: 'conversation', what: 'A chat message' },
];

/**
 * What each retained table holds, in the reader's words rather than the
 * schema's. The windows themselves come from `RETENTION`, so the sentence and
 * the cron cannot drift; a table added there without an entry here falls back
 * to its own name rather than rendering `undefined`.
 */
const RETENTION_LABELS: Record<string, string> = {
  chat_turns: 'Chat questions and answers',
  mcp_tool_calls: 'The MCP audit log',
  fit_reports: 'Stored analysis reports',
};

const releases = recentReleases(changelog, 5);

/**
 * The status line in the masthead, DERIVED rather than asserted.
 *
 * The design draws it as a green square and the words "all systems nominal". A
 * line hardcoded to that, sitting above a page that says three of its figures
 * could not be read, is worse than no line at all: it is the same invisible lie
 * as a rendered zero, moved to the top of the page and set in the one colour
 * this site reserves for "nothing is wrong".
 *
 * BOTH ARMS COUNT READS NOW, AND THE NOMINAL ARM DID NOT. An earlier version of
 * this comment had the non-nominal arm counting reads "rather than reaching for
 * the nominal arm's vocabulary", which left the vocabulary in place on the arm
 * a reader is least able to check: "all systems nominal" is an uptime claim,
 * and nothing on this page is tied to a monitor. What it performs is exactly
 * three reads, and what it can honestly report is whether those three answered.
 * Nothing here probes the MCP Worker, the queue or the rate limiter, and a site
 * that was entirely down would not be serving this page to be read. So the
 * nominal arm names its own evidence too, and keeps the colour, because every
 * source answering is still worth seeing at a glance.
 *
 * AN UNCONFIGURED TOKEN AND A D1 OUTAGE BOTH LAND HERE AS "did not answer", and
 * that flattening is deliberate at this size. They differ in what the owner
 * should DO about them, and the tile that could not be read is where that
 * difference is already spelled out, per system, in words. This line is five
 * words at the top of a page; it says how many, and the band says which.
 */
const READS = [metrics, traffic, spend];
const unreadCount = READS.filter((read) => read === null).length;
const status = {
  state: unreadCount === 0 ? 'nominal' : 'degraded',
  label:
    unreadCount === 0
      ? `${READS.length} of ${READS.length} sources answered`
      : `${unreadCount} of ${READS.length} sources unavailable`,
};

/**
 * The 1440px cap and the 40px gutter, in the three arrangements this page uses.
 *
 * `BLEED` is the cap WITHOUT the gutter, and that is not an oversight. The
 * design runs the metric and panel bands edge to edge, so the outer hairline of
 * a band is the first and last thing on its line. The cap still applies, so on
 * a wide display they stop at 1440 with everything else rather than stretching
 * to the window.
 */
const COLUMN = 'mx-auto max-w-[1440px] px-5 lg:px-10';
const BLEED = 'mx-auto max-w-[1440px]';

/**
 * A full-width section's opening: kicker and heading left, the section's one
 * paragraph right.
 *
 * THE RIGHT COLUMN IS NOT RIGHT-ALIGNED, which the design's own architecture
 * header is. That works there because the prototype's paragraph is two lines;
 * this page's are four and five, and a ragged left edge down five lines is hard
 * to read for no gain. The grid is the design's, the alignment is not.
 *
 */
const HEAD = `${COLUMN} grid items-baseline gap-x-16 gap-y-3 pb-8 pt-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,34rem)]`;

/** The kicker over a full-width section, and the same line inside a panel. */
const KICKER = 'font-mono text-micro uppercase text-ink-muted';
/** A full-width section's heading. */
const HEADING = 'font-display text-heading text-ink';
/**
 * One panel in a hairline band, and the heading that opens it.
 *
 * `min-w-0` IS THE GUARD, NOT PADDING (issue #113). A panel is a grid item, and
 * a grid item's default `min-width: auto` is its min-content width -- so the
 * evals table's `min-w-[22rem]` inside `overflow-x-auto` would grow this track
 * rather than scroll inside it. It does not today, and only because 22rem is
 * 352px and that is narrower than a 390px viewport. /ai-policy's risk register
 * is the same construction one size up (56rem) and it overflowed that page by
 * 543px. Widening this table by a column is all it would take here, so the
 * guard goes on while the reason is written down rather than after.
 */
const PANEL = 'min-w-0 bg-surface px-6 pb-8 pt-[26px]';
const PANEL_HEADING = 'font-mono text-micro uppercase text-ink';

/**
 * The six sections below, in the order the page renders them. The index in the
 * masthead is the only thing that reads this.
 *
 * SIX CELLS, AND THE COUNT IS ARITHMETIC RATHER THAN TASTE. It is the same rule
 * the metrics band follows for the same reason: a `hairline-grid` paints
 * --rl-rule as its own ground and the gaps are where it shows through, so a row
 * that runs short is a block of grey rather than whitespace. Six divides by two
 * and by three, which is exactly the column counts this index uses. A seventh
 * section is a breakpoint decision, not an appended entry.
 *
 * THE QUALIFIER IS A SHORTENED ECHO OF EACH SECTION'S OWN KICKER, and not a
 * second source of truth for it. The kickers are written where the sections
 * are, this line only has to tell a reader what they will find, and the two
 * drifting apart in wording costs nothing. The `id` is the load-bearing half:
 * tests/ops-page.test.ts fails if any entry here names an anchor the page does
 * not render, which is the failure a hand-written index actually has.
 */
const SECTIONS: { number: string; id: string; name: string; qualifier: string }[] = [
  { number: '01', id: 'architecture', name: 'Architecture', qualifier: 'Deployed shape' },
  {
    number: '02',
    id: 'live-metrics',
    name: 'Live metrics',
    qualifier: `Last ${formatWindow(WINDOW_DAYS)}`,
  },
  { number: '03', id: 'model-cost', name: 'Model & cost', qualifier: 'Constants in this build' },
  { number: '04', id: 'evals', name: 'Evals', qualifier: 'Latest run per suite' },
  { number: '05', id: 'status', name: 'Status & degradation', qualifier: 'When a part fails' },
  { number: '06', id: 'releases', name: 'Release history', qualifier: 'Latest releases' },
];
---

<Shell
  title="Ops"
  description="What this site is running, what it has served in the last 30 days, which models it spends, how it degrades, and what shipped: every figure labeled with the system it was read from."
  ogCard={OPS_CARD}
>
  {/*
      A FILLED PANEL, WHICH MEANS THE CASE-STUDY MASTHEAD'S WHOLE CONTRACT AND
      NOT ITS LOOK ALONE. THREE FILES, ONE DECISION, the same three
      ArticleLayout.astro names: the `dark:` variant below drops the inversion
      for a visitor running JavaScript, global.css carries the
      `:root:not([data-theme='light'])` twin for the visitor who never receives
      the attribute and the `@media print` pin for a medium that is neither
      theme, and tests/inverted-blocks.test.ts and tests/print.test.ts fail if
      `data-ops-panel` drifts out of either. Adding a filled block anywhere on
      this site means all three.

      NO CLOSING RULE IN LIGHT, for the reason the case-study panel gives: the
      filled block's own edge is what closes it. The `dark:border-b` below is
      the same exception that template makes, because a de-inverted panel is
      `--rl-surface-raised` against `--rl-bg`, which is 1.16:1 and closes
      nothing.
    */}
  <section data-ops-masthead>
    {/*
        `data-ops-panel` is BOTH a styling hook and a test hook, and it has to
        be: global.css needs a selector for the two rules that reach past the
        utilities below, and the two contract tests read the same string.

        The kicker is `--rl-accent-ground` rather than `--rl-accent` for the
        reason ArticleLayout.astro records at length: it is the one accent token
        that does not flip between themes, so the same pink clears 5.71:1 on the
        near-black panel in light and 4.91:1 on the raised panel in dark.

        EVERYTHING ELSE ON THE PANEL NAMES NO COLOUR AT ALL, which is the whole
        trick that makes the index work on both grounds. `text-bg` is declared
        once, here, and the H1, the status words, the six boxes and their rules
        are all `currentColor` or an opacity of it. In light that resolves to
        --rl-bg on near-black; in dark the shell's own `dark:text-ink` resolves
        it to --rl-ink on the raised panel. Both are the near-white end of their
        ramp, so one declaration covers two grounds and no child needs a `dark:`
        variant of its own.
      */}
    <div
      data-ops-panel
      class="bg-ink text-bg dark:border-b dark:border-rule dark:bg-surface-raised dark:text-ink"
    >
      <div class:list={[COLUMN, 'pb-14 pt-14']}>
        <div class="flex flex-wrap items-baseline justify-between gap-x-10 gap-y-3">
          <p class="font-mono text-micro uppercase text-accent-ground">Ops dashboard</p>
          {/*
              THE STATUS WORDS ARE NOT COLOURED AND THE SQUARE IS, WHICH IS A
              MEASUREMENT RATHER THAN A PREFERENCE. Against the light panel's
              own ground, #0a0a0b: `--rl-ok` is 3.63:1 and `--rl-warn` is
              3.34:1. Both fail AA for 12px text, and both clear the 3:1
              threshold that governs a non-text indicator, so the colour goes
              where it is legible and the words take the panel's own near-white.
              The label states the count in words either way.

              `data-status-pill` and `data-status` are TEST HOOKS, the same
              declared convention as `data-ops-metric` below. The pair is what
              lets the test assert that the line HAS a derived state without
              pinning which one: the harness runs with the analytics reads
              stubbed and the deployed site does not, so the value legitimately
              differs between them and only its derivation is a property worth
              asserting.
            */}
          <p
            data-status-pill
            data-status={status.state}
            class="flex flex-wrap items-center gap-x-2.5 gap-y-1 font-mono text-micro uppercase"
          >
            <span
              aria-hidden="true"
              class:list={['h-2 w-2 shrink-0', status.state === 'nominal' ? 'bg-ok' : 'bg-warn']}
            ></span>
            <span>{status.label}</span>
            <span class="opacity-[.7]">· Last {formatWindow(WINDOW_DAYS)}</span>
          </p>
        </div>
        <h1 class="mt-5 font-display text-headline">What's running and what it costs</h1>
        {/*
            The index, and it is deliberately built from the same parts as the
            drawing one section below: the cell is the ingress row's padding,
            the head is that row's own construction of a muted number beside a
            mono label. A reader meets the vocabulary here and then reads the
            diagram in it.

