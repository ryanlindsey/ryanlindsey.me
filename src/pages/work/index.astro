---
import { getCollection } from 'astro:content';
import Shell from '../../layouts/Shell.astro';

const caseStudies = (await getCollection('caseStudies', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
---

<Shell
  title="Work — Ryan Lindsey"
  description="Case studies: what the work was, how it actually worked, and what I would do differently."
>
  <div class="mx-auto max-w-5xl px-6 py-16">
    <p class="mb-6 border-t border-accent pt-3 font-mono text-micro uppercase text-accent">Work</p>
    <h1 class="max-w-3xl font-display text-title text-ink">The work, with the mechanism shown.</h1>

    {
      caseStudies.length === 0 ? (
        <p class="mt-16 font-mono text-micro uppercase text-ink-muted" data-testid="work-empty">
          First case studies land this week.
        </p>
      ) : (
        <ul class="mt-16 border-t border-rule">
          {caseStudies.map((study) => (
            <li class="border-b border-rule">
              <a href={`/work/${study.id}`} class="group block py-6">
                <span class="font-mono text-micro uppercase text-ink-muted">
                  <time datetime={study.data.publishedAt.toISOString()}>
                    {study.data.publishedAt.toISOString().slice(0, 10)}
                  </time>
                  {' · '}
                  Case study
                </span>
                <h2 class="mt-2 font-display text-heading text-ink group-hover:text-accent">
                  {study.data.title}
                </h2>
                <p class="mt-2 max-w-2xl text-ink-muted">{study.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Shell>
