---
import { getCollection } from 'astro:content';
import Shell from '../layouts/Shell.astro';
import { PILLAR_LABELS } from '../lib/pillars';
import { readingTimeFor } from '../lib/reading-time';
import { getResume } from '../lib/resume-collection';
import { getNowItems } from '../lib/now-collection';

// Queried once and sliced, rather than two `getCollection` calls with
// different filters: the lead and the cells have to agree about which post is
// the most recent, and two queries is how they stop agreeing.
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const lead = posts.at(0);
const more = posts.slice(1, 4);

const { basics } = await getResume();
const nowItems = await getNowItems();

const day = (date: Date) => date.toISOString().slice(0, 10);

// Column count follows cell count, the same rule the `:::figures` directive
// states and for the same reason `hairline-grid` refuses to set columns: a
// three-column track with two cells does not render an empty cell, it renders
// a strip of the rule-coloured ground where a third card should be, which
// reads as a broken card rather than as a shorter row. Spelled as whole class
// strings because Tailwind v4 scans this file as text and never sees a class
// name that was assembled at runtime.
const COLUMNS = ['', 'lg:grid-cols-1', 'lg:grid-cols-2', 'lg:grid-cols-3'];
const moreColumns = COLUMNS[more.length] ?? 'lg:grid-cols-3';
---

<Shell
  title="Ryan Lindsey"
  titleIsSiteName
  description="Ryan Lindsey writes about agentic engineering and engineering leadership. This site also carries a full resume and an agent that answers questions about the work."
  markdownHref="/index.md"
>
  <!--
    THE ONE `dark:` VARIANT IN THE WHOLE REDESIGN, and it is deliberate.
    The epic's global constraints say no `dark:` variant is needed anywhere,
    because every token is redeclared per theme and the utilities therefore
    follow. That is true of every other block on this site. It is not true
    here: the Now strip is a design-level difference between the themes rather
    than a token-level one. Light inverts the band to `--rl-ink`; dark drops
    the inversion for `--rl-surface-raised` and a bottom rule, because a
    near-white bar directly under the header reads as a glare rather than as
    emphasis. Handoff README, *Home*, and design 2a.

    The `dark:` variant keys off `[data-theme='dark']` (the `@custom-variant`
    in global.css), which the head script always writes -- so it covers every
    visitor running JavaScript. It does NOT cover the no-JS visitor on a dark
    OS, who gets dark tokens from tokens.css's `prefers-color-scheme` block
    without ever getting the attribute. With utilities alone that visitor
    would land on `bg-ink` resolved against the DARK palette, where `--rl-ink`
    is the near-white end of the ramp: exactly the glaring white bar this block
    exists to avoid, and the failure would be invisible to anyone testing with
    JavaScript on.
    global.css carries the matching `prefers-color-scheme` rule for that path,
    guarded with `:not([data-theme='light'])` the way tokens.css guards its
    own no-JS block. Both have to change together.
  -->
  <section
    class="bg-ink text-bg dark:border-b dark:border-rule dark:bg-surface-raised dark:text-ink"
    data-now-strip
  >
    <div class="mx-auto flex max-w-[1440px] items-baseline gap-3 px-5 py-4 lg:px-10">
      <span class="bg-accent-ground px-[7px] py-[3px] font-mono text-micro text-accent-on">
        NOW
      </span>
      <!--
        Edited in src/content/now/now.yaml, often, and expected to go stale
        between edits. See that file's header for what it may and may not say.
      -->
      <p class="text-small">{nowItems.join(' · ')}</p>
    </div>
  </section>

  <section class="mx-auto grid max-w-[1440px] gap-10 border-b border-rule px-5 pb-11 pt-10 lg:grid-cols-[minmax(0,1.55fr)_minmax(0,1fr)] lg:gap-16 lg:px-10 lg:pt-12">
    {lead ? (
      // One wrapper link around the whole left column, and not underlined:
      // the design's rule for a whole-card link. `data-lead-story` is the
      // first attribute on purpose -- tests/pages.test.ts matches from it to
      // the closing tag and would not see a `class` emitted ahead of it.
      <a data-lead-story href={`/writing/${lead.id}`} class="block no-underline">
        <p class="font-mono text-micro uppercase text-accent">
          Latest &middot; {PILLAR_LABELS[lead.data.pillar] ?? lead.data.pillar}
        </p>
        <h1 class="mt-4 font-display text-lead text-ink">{lead.data.title}</h1>
        <p class="mt-6 max-w-[58ch] text-large text-ink-muted">{lead.data.description}</p>
        <p class="mt-6 font-mono text-micro uppercase text-ink-muted">
          <time datetime={lead.data.publishedAt.toISOString()}>{day(lead.data.publishedAt)}</time>
          {' · '}
          {readingTimeFor(lead.body).minutes} min read
        </p>
      </a>
    ) : (
      // No published posts means no lead story, so the 1.55fr column is not
      // rendered empty -- the right column stands alone and says why. The
      // site has published posts today, so this is a guard rather than a
      // live state, and it matches the `writing-empty` state the index
      // pages have carried since launch.
      <p data-testid="home-empty" class="font-mono text-micro uppercase text-ink-muted">
        First pieces land soon.
      </p>
    )}

    <div class="lg:border-l lg:border-rule lg:pl-10">
      <div data-bio>
        <p class="font-mono text-micro uppercase text-ink-muted">Who is writing</p>
        {/*
          A `{...}` COMMENT, NOT AN HTML ONE, AND THAT IS THE POINT. Astro
          ships `<!-- -->` to the client; this form is evaluated away at build.
          Naming the prototype's copy below is the whole value of this note,
          and an HTML comment naming it would put the employer on the
          positioning surface just as surely as the copy would. Caught by
          tests/pages.test.ts's employer scan on the first run of this page,
          which is the same trap in reverse that the holding-page test records:
          an HTML comment is part of the response, and a check that reads the
          response cannot tell the two apart.

          Built from the résumé record, not typed here, and the employer is
          omitted rather than abbreviated. 00 §5, the rule
          `src/content.config.ts` states beside `resumeSchema`: the résumé
          names the employer in `work`, positioning surfaces do not. The
          prototype's copy for this block appended "at <the employer>" to the
          line below, which is exactly what that rule forbids.

          `basics.summary` is rendered whole rather than sliced to the
          prototype's two lines. A rule like "the sentence before the colon"
          would put a fragment of the next rewrite on the home page silently,
          and this paragraph is the canonical positioning paragraph already:
          it was written under this same constraint, which is why it names no
          employer for this page to have to strip.
        */}
        <p class="mt-3 text-body text-ink">
          <strong class="font-semibold">{basics.name}</strong>, {basics.label}.
        </p>
        <p class="mt-3 text-small text-ink-muted">{basics.summary}</p>
      </div>

      <div class="mt-7 flex flex-wrap gap-3 border-t border-rule pt-7">
        <a
          href="/resume"
          class="bg-accent-ground px-[14px] py-[9px] font-mono text-small text-accent-on no-underline"
        >
          Read the resume
        </a>
        <a
          href="/chat"
          class="border border-ink px-[14px] py-[9px] font-mono text-small text-ink no-underline"
        >
          Ask my agent
        </a>
      </div>
    </div>
  </section>

  {more.length > 0 && (
    <section data-more-writing class="mx-auto max-w-[1440px] px-5 py-10 lg:px-10 lg:py-12">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="font-mono text-micro uppercase text-ink-muted">More writing</h2>
        <a href="/writing" class="font-mono text-micro uppercase text-accent">
          All posts &rarr;
        </a>
      </div>

      {/* --rl-surface here, not --rl-bg: the cell background is the caller's
            to choose, which is why hairline-grid does not set one. The figures
            directive picks the other token. */}
      <div class={`hairline-grid mt-6 grid-cols-1 ${moreColumns}`}>
        {more.map((post) => (
          <a
            href={`/writing/${post.id}`}
            class="flex min-h-[210px] flex-col bg-surface px-6 pb-7 pt-[26px] no-underline"
          >
            <p class="font-mono text-micro uppercase text-ink-muted">
              <time datetime={post.data.publishedAt.toISOString()}>
                {day(post.data.publishedAt)}
              </time>
              {' · '}
              {PILLAR_LABELS[post.data.pillar] ?? post.data.pillar}
            </p>
            <h3 class="mt-3 font-display text-heading text-ink">{post.data.title}</h3>
            <p class="mt-3 text-small text-ink-muted">{post.data.description}</p>
            <p class="mt-auto pt-6 font-mono text-micro uppercase text-accent">
              {readingTimeFor(post.body).minutes} min &rarr;
            </p>
          </a>
        ))}
      </div>
    </section>
  )}

  <script>
    import { WEBMCP_TOOLS, callMcp } from '../lib/discovery/webmcp';

    // WebMCP (https://webmachinelearning.github.io/webmcp/), an early-preview
    // browser API for registering tools an in-page agent can call directly,
    // without speaking the MCP wire protocol itself. `navigator.modelContext`
    // is undefined in almost every browser today, and that absence is the
    // ordinary case, not a fault -- so this reads it into a local rather than
    // branching on `'modelContext' in navigator`, which leaves no bare access
    // on a value that might be undefined and nothing here that throws on load
    // for the near-universal visitor without the flag.
    //
    // The ambient type is declared here rather than in a .d.ts, because this
    // is the only file that touches it -- the same rule chat.astro's own
    // `<script>` already follows for `window.turnstile`.
    declare global {
      interface Navigator {
        modelContext?: {
          provideContext(context: { tools: RegisteredWebMcpTool[] }): void;
        };
      }
    }

    interface RegisteredWebMcpTool {
      name: string;
      description: string;
      inputSchema: { type: 'object'; properties: Record<string, unknown>; required?: string[] };
      execute: (args: Record<string, unknown>) => Promise<unknown>;
    }

    const modelContext = navigator.modelContext;
    if (modelContext) {
      modelContext.provideContext({
        tools: WEBMCP_TOOLS.map((tool) => ({
          ...tool,
          execute: (args: Record<string, unknown>) => callMcp(tool.name, args),
        })),
      });
    }
  </script>
</Shell>
