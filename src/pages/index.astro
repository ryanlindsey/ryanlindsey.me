---
import Shell from '../layouts/Shell.astro';
---

<Shell title="Ryan Lindsey">
  <section class="mx-auto max-w-5xl px-6 py-24">
    <!-- The signature move: a hairline rule and a mono eyebrow above very
         large display type. Flat, square, no glow. -->
    <p class="mb-6 border-t border-accent pt-3 font-mono text-micro uppercase text-accent">
      Engineering leadership &middot; agentic systems
    </p>

    <h1 class="max-w-3xl font-display text-display text-ink">
      I re-engineer how organizations work with agentic AI.
    </h1>

    <p class="mt-8 max-w-xl text-ink-muted">
      Production agents, MCP infrastructure, and the governance that makes them safe. This site is
      being built in the open.
    </p>

    <p class="mt-16 font-mono text-micro uppercase text-ink-muted" data-testid="holding-page">
      ryanlindsey.me &mdash; under construction
    </p>
  </section>
</Shell>
