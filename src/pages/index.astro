---
import Base from '../layouts/Base.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
---

<Base title="Ryan Lindsey">
  <main class="mx-auto flex min-h-dvh max-w-2xl flex-col justify-center gap-4 px-6">
    <h1 class="text-3xl font-semibold tracking-tight">Ryan Lindsey</h1>
    <p class="text-neutral-600 dark:text-neutral-400">
      Engineering leadership and agentic systems. This site is being built in the open.
    </p>
    <p class="font-mono text-sm text-neutral-500" data-testid="holding-page">
      ryanlindsey.me — under construction
    </p>
    <ThemeToggle />
  </main>
</Base>
